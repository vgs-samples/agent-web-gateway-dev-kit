  },
  "body": {
   "adyenData": {
    "encryptedAdyenForm": {
     "encryptedAdyenExpiryMonth": "browser-jwe",
     "encryptedAdyenExpiryYear": "browser-jwe"
    },
    "cardPaymentId": ""
   },
   "firstName": "Test"
  }
 },
 "session": {
  "values": {
   "adyen_public_key": "10001|",
   "adyen_generationtime": "2026-11-12T10:25:28Z"
  },
  "context": {
   "adyen_expiry_month": "10",
   "adyen_expiry_year": "2030"
  }
 },
 "destination": "$binding:checkout"
}