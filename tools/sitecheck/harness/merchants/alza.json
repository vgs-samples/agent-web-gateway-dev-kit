{
  "name": "Alza (www.alza.cz)",
  "adapter": "ADNepZjV7BxFSWYttAmh4afX",
  "capture": {
    "binding": "AX1S5A14mY95X2AhXHAbC8GD",
    "response": {"status": 200, "headers": {"Content-Type": "application/json"},
                 "body": {"form": {"value": [{"name": "merchantAccount", "value": "AlzaCZ"},
                                             {"name": "publicKey", "value": "$harness_key"}]}}}
  },
  "checkout": {
    "binding": "AXKsqGuNDS9dd8W3QotNoGwG",
    "method": "POST",
    "url": "https://www.alza.cz/api/payment/v3/adyenpayment",
    "headers": {"Content-Type": "application/json"},
    "body": {
      "encryptedCardNumber": "browser-jwe-number",
      "encryptedExpiryMonth": "browser-jwe-expiryMonth",
      "encryptedExpiryYear": "browser-jwe-expiryYear",
      "encryptedSecurityCode": "browser-jwe-cvc",
      "orderId": "test"
    }
  },
  "context": {"adyen_expiry_month": "03", "adyen_expiry_year": "2030"}
}
