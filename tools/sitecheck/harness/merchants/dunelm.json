{
  "name": "Dunelm (was.dunelm.com)",
  "adapter": "ADNepZjV7BxFSWYttAmh4afX",
  "capture": {
    "binding": "AXQvNGzQwPnwwdbDwuHxuz1c",
    "response": {"status": 200, "headers": {"Content-Type": "text/html; charset=utf-8"},
                 "body_file": "fixtures/adyen-securedfields-hm.html"}
  },
  "checkout": {
    "binding": "AX1v4vrpMMKJC9LjjFAiWV9c",
    "method": "POST",
    "url": "https://was.dunelm.com/graphql",
    "headers": {"Content-Type": "application/json"},
    "body": {
      "query": "$binding_input:graphql_query",
      "variables": {
        "input": {
          "paymentMethod": {
            "type": "scheme",
            "encryptedCardNumber": "browser-jwe-number",
            "encryptedExpiryMonth": "browser-jwe-expiryMonth",
            "encryptedExpiryYear": "browser-jwe-expiryYear",
            "encryptedSecurityCode": "browser-jwe-cvc"
          }
        }
      }
    }
  },
  "context": {"adyen_expiry_month": "03", "adyen_expiry_year": "2030"}
}
