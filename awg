#!/usr/bin/env bash
# One entry point for the Agent Web Gateway dev kit.
#
#   ./awg test                 run the kit's offline tests (no credentials, nothing sent to VGS)
#   ./awg setup [--organization AC…]  log in and provision Sandbox credentials
#   ./awg session [hosts]      create a reveal session for a test card (hosts: comma-separated)
#   ./awg start [url]          one step: session + control panel helper + CloakBrowser
#   ./awg kernel [url]         session + a Kernel cloud browser routed through it (needs KERNEL_API_KEY)
#   ./awg panel [options]      start only the control panel helper (options of start-proxy-controls.py)
#   ./awg browser [options]    open only CloakBrowser with the control panel (--session FILE [url])
#   ./awg cloak-login          save your CloakBrowser license key (once)
#   ./awg sitecheck [args]     run the awg-sitecheck tool (arguments of awg-sitecheck)
#
# uv supplies Python for the kit, the browser and VGS CLI; nothing is compiled.
# Private files live in ~/.awg-dev-kit, readable only by you.
set -euo pipefail
umask 077

KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANEL_DIR="$KIT_DIR/tools/vgs-proxy-controls"
SITECHECK_DIR="$KIT_DIR/tools/sitecheck"
PYTHON_VERSION="3.12"
VGS_CLI_VERSION="1.37.0"

STATE_DIR="${AWG_HOME:-$HOME/.awg-dev-kit}"
CREDENTIALS="$STATE_DIR/sandbox.env"
SESSIONS_DIR="$STATE_DIR/sessions"
CARD_FILE="$STATE_DIR/card.json"
LATEST="$STATE_DIR/latest-session"
HELPER_LOG="$STATE_DIR/helper.log"
PROFILE_DIR="$STATE_DIR/cloak-profile"

API="https://sandbox.vgsapi.com"
AUTH="https://auth.verygoodsecurity.com/auth/realms/vgs/protocol/openid-connect/token"

say()  { printf '%s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

need_uv() {
  have uv && return
  say "Installing uv for the kit runtime..."
  if have brew; then
    brew install uv
  else
    have curl || fail "curl is required to install uv. Install it with your package manager."
    local installer
    installer=$(mktemp)
    curl -fsSL https://astral.sh/uv/install.sh -o "$installer" || { rm -f "$installer"; fail "could not download uv installer"; }
    sh "$installer" || { rm -f "$installer"; fail "uv installation failed"; }
    rm -f "$installer"
  fi
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
  have uv || fail "uv installation did not put uv on PATH. See https://docs.astral.sh/uv/getting-started/installation/"
}

# CloakBrowser needs a license key on every launch; ask for it once.
need_cloak_license() {
  [ -n "${CLOAKBROWSER_LICENSE_KEY:-}" ] && return
  [ -s "$HOME/.cloakbrowser/license.key" ] && return
  if [ -t 0 ]; then cmd_cloak_login; else fail "CloakBrowser needs a license key. Run './awg cloak-login' in your own terminal."; fi
}

# Run Python from the kit with the pinned version. uv downloads it on first use.
kit_python() {
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" python "$@"
}

# CloakBrowser is installed on demand by uv; nothing to set up beyond a license key.
cloak_python() {
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" --with cloakbrowser "$@"
}

# VGS CLI gets a private environment on a prebuilt Python from uv, never an arbitrary vgs on PATH.
# Nothing is compiled, so setup does not depend on the machine's compiler or OpenSSL.
need_vgs_cli() {
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  need_uv
  CLI_ENV="$STATE_DIR/vgs-cli-$VGS_CLI_VERSION-uv-py$PYTHON_VERSION"
  if [ ! -x "$CLI_ENV/bin/vgs" ]; then
    say "Installing VGS CLI $VGS_CLI_VERSION (private to this kit)..."
    rm -rf "$CLI_ENV"
    uv venv --quiet --python "$PYTHON_VERSION" "$CLI_ENV" || fail "uv could not prepare Python $PYTHON_VERSION for VGS CLI. Check your network connection and retry."
    uv pip install --quiet --python "$CLI_ENV/bin/python" "vgs-cli==$VGS_CLI_VERSION" || { rm -rf "$CLI_ENV"; fail "could not install VGS CLI $VGS_CLI_VERSION from PyPI. Check your network connection and retry."; }
  fi
  # Local help validates the installed command surface without authentication.
  # The first run compiles the CLI; keep its own SyntaxWarning out of the developer's terminal.
  env -u VGS_CLIENT_ID -u VGS_CLIENT_SECRET PYTHONWARNINGS=ignore::SyntaxWarning "$CLI_ENV/bin/vgs" get tenants --help >/dev/null
  env -u VGS_CLIENT_ID -u VGS_CLIENT_SECRET PYTHONWARNINGS=ignore::SyntaxWarning "$CLI_ENV/bin/vgs" apply service-account --help >/dev/null
}

# ---------------------------------------------------------------- offline tests

cmd_test() {
  say "Bootstrap and CLI tests (offline synthetic fixtures)..."
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" --with PyYAML==6.0.3 \
    python -m unittest discover -s "$KIT_DIR/tests" -p 'test_*.py'
  say "Control panel helper tests (Python $PYTHON_VERSION)..."
  (cd "$PANEL_DIR" && kit_python -m unittest discover -p 'test_*.py')
  if have node; then
    say ""
    say "Extension tests (node)..."
    (cd "$PANEL_DIR" && node --test test_session_proxy_extension.mjs)
  else
    say ""
    say "Skipped the extension tests: node is not installed."
  fi
}

# ---------------------------------------------------------------- credentials

cred() { grep -E "^$1=" "$CREDENTIALS" | head -1 | cut -d= -f2-; }

need_credentials() {
  [ -f "$CREDENTIALS" ] || fail "no saved credentials. Run:  ./awg setup"
}

access_token() {
  local token
  token=$(curl -sS -X POST "$AUTH" -d grant_type=client_credentials \
    --data-urlencode "client_id=$(cred VGS_CLIENT_ID)" \
    --data-urlencode "client_secret=$(cred VGS_CLIENT_SECRET)" | jq -r '.access_token // empty') || true
  [ -n "$token" ] || fail "VGS did not issue an access token. Check the client id and secret, then run ./awg setup --force"
  printf '%s' "$token"
}

cmd_setup() {
  # Validate flags before downloading anything or opening login.
  local arg
  local -a SETUP_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h) say "Usage: ./awg setup [--organization AC…] [--tenant tnt…] [--force]
Log in with VGS, confirm the organization, and provision a Sandbox service account.
--organization records your confirmed choice; --tenant overrides automatic Sandbox selection.
--force replaces saved credentials (does not delete the old service account)."; return ;;
      --organization|--tenant)
        [ $# -ge 2 ] && [ -n "$2" ] && [[ "$2" != --* ]] || fail "$1 needs a value"
        arg="$1"; shift
        SETUP_ARGS+=("$arg" "$1") ;;
      --force) SETUP_ARGS+=("$1") ;;
      *) fail "unknown option for setup: $1" ;;
    esac
    shift
  done
  need_vgs_cli
  "$CLI_ENV/bin/python" "$KIT_DIR/tools/bootstrap/setup.py" --state-dir "$STATE_DIR" \
    --vgs "$CLI_ENV/bin/vgs" ${SETUP_ARGS[@]+"${SETUP_ARGS[@]}"}
  [ "${AWG_IN_START:-}" = 1 ] || say "Next: ./awg start"
}

# ---------------------------------------------------------------- session

session_alive() {  # session_alive <file>
  [ -f "$1" ] && jq -e '(.data.attributes.expires_at | fromdateiso8601) > (now + 60)' "$1" >/dev/null 2>&1
}

latest_session() { [ -f "$LATEST" ] && cat "$LATEST" || true; }

# Scopes carried by an access token, space-separated; empty if the token cannot be read.
token_scopes() {  # token_scopes <token>
  printf '%s' "$1" | jq -rR '(split(".")[1] | gsub("-";"+") | gsub("_";"/")) as $p
    | ($p + ("==="[0:((4 - ($p | length) % 4) % 4)])) | @base64d | fromjson
    | if "'"${2:-scope}"'" == "roles" then ((.resource_access // {}) | [.[].roles[]?] | join(" ")) else (.scope // "") end' 2>/dev/null || true
}

# The APIs read the token's scope claim. An account can hold a scope as a role and still get a token without it.
SCOPES_HELD=""; SCOPES_GRANTED=""; CARD_ERROR=""; ALIAS_ERROR=""
read_token_scopes() {  # read_token_scopes <token>
  SCOPES_HELD=" $(token_scopes "$1") "
  SCOPES_GRANTED=" $(token_scopes "$1" roles) "
  [ -n "${SCOPES_HELD// /}" ] || SCOPES_HELD="$SCOPES_GRANTED"
  [[ "$SCOPES_HELD" != *" cards:write "* ]] || SCOPES_HELD="$SCOPES_HELD cards:create cards:update "
  [[ "$SCOPES_GRANTED" != *" cards:write "* ]] || SCOPES_GRANTED="$SCOPES_GRANTED cards:create cards:update "
}

# The account may not have been created by this kit. Say what it lacks before any call is refused.
report_account_scopes() {  # report_account_scopes <token>
  local scope missing="" unissued=""
  read_token_scopes "$1"
  [ -n "${SCOPES_HELD// /}" ] || return 0
  for scope in cards:create cards:read cards:update aliases:write reveal-sessions:read reveal-sessions:write agent-gateway:read agent-gateway:write; do
    [[ "$SCOPES_HELD" != *" $scope "* ]] || continue
    if [[ "$SCOPES_GRANTED" = *" $scope "* ]]; then unissued="$unissued${unissued:+, }$scope"
    else missing="$missing${missing:+, }$scope"; fi
  done
  if [ -n "$missing" ]; then
    say "Note: this service account lacks: $missing."
    say "      The kit works with what the account has. If a step below is refused, that is the reason;"
    say "      './awg setup --force' creates an account with every scope the kit uses."
  fi
  if [ -n "$unissued" ]; then
    say "Note: this service account was granted $unissued, but VGS leaves them out of its access token."
    say "      The kit works with what the token has. A new account is likely to get the same token,"
    say "      so this needs VGS: report it with your organization and tenant IDs."
  fi
}

# Why the Cards API refused, in terms the developer can act on.
explain_card_refusal() {  # explain_card_refusal <token>
  [[ "$CARD_ERROR" = "HTTP 403"* ]] || return 0
  read_token_scopes "$1"
  [ -n "${SCOPES_HELD// /}" ] || return 0
  if [[ "$SCOPES_HELD" = *" cards:create "* ]]; then
    say "  This service account has the card scope, so the Cards API itself is not enabled for tenant $2. Only VGS can enable it."
  elif [[ "$SCOPES_GRANTED" = *" cards:create "* ]]; then
    say "  This service account was granted cards:create, but its access token does not carry it. Only VGS can fix that; a new account is unlikely to help."
  else
    say "  This service account was created without cards:create. Scopes cannot be added later; './awg setup --force' makes a new account."
  fi
}

# Same test card through the vault alias API (aliases:write), for tenants where the Cards API refuses.
store_test_aliases() {  # store_test_aliases <token> <tenant>
  local response code
  response=$(mktemp "$STATE_DIR/card.XXXXXX")
  code=$(curl -sS -o "$response" -w '%{http_code}' -X POST "https://$2.sandbox.vault-api.verygoodvault.com/aliases" \
    -H "Authorization: Bearer $1" -H 'Content-Type: application/json' \
    -d '{"data":[{"value":"4111111111111111","format":"UUID","storage":"PERSISTENT"},{"value":"123","format":"UUID","storage":"VOLATILE"}]}') || code=000
  if [ "$code" = 201 ] && jq -e '.data | length == 2' "$response" >/dev/null 2>&1; then
    jq '[.data[] | (.aliases | map(select(.format == "UUID")) | .[0].alias)] as $a
        | {pan_alias: $a[0], cvc_alias: $a[1], bin: "411111", length: 16, fresh: true}' "$response" > "$CARD_FILE"
    rm -f "$response"
    jq -e '.pan_alias and .cvc_alias' "$CARD_FILE" >/dev/null 2>&1 && return 0
    rm -f "$CARD_FILE"
    ALIAS_ERROR="HTTP 201 without aliases"
    return 1
  fi
  ALIAS_ERROR="HTTP $code $(jq -c '[.errors[]? | {code, title, detail}] // .' "$response" 2>/dev/null | cut -c1-400)"
  rm -f "$response"
  return 1
}

# Stores the standard VGS test card so the session has fresh aliases. Never a real card.
store_test_card() {  # store_test_card <token>
  local response code year
  response=$(mktemp "$STATE_DIR/card.XXXXXX")
  year=$(( ($(date +%Y) + 3) % 100 ))   # the cards API takes a two-digit year
  code=$(curl -sS -o "$response" -w '%{http_code}' -X POST "$API/cards" \
    -H "Authorization: Bearer $1" -H 'Content-Type: application/vnd.api+json' -H 'Accept: application/vnd.api+json' \
    -d "$(jq -n --argjson y "$year" '{data:{attributes:{pan:"4111111111111111",cvc:"123",exp_month:12,exp_year:$y}}}')") || code=000
  if { [ "$code" = 201 ] || [ "$code" = 303 ]; } && jq -e '.data.attributes.pan_alias' "$response" >/dev/null 2>&1; then
    jq '.data | {card_id: .id, pan_alias: .attributes.pan_alias, cvc_alias: .attributes.cvc_alias,
                 bin: (.attributes.bin // "411111"), length: 16, fresh: true}' "$response" > "$CARD_FILE"
    rm -f "$response"
    return 0
  fi
  CARD_ERROR="HTTP $code $(jq -c '[.errors[]? | {code, title, detail}] // .' "$response" 2>/dev/null | cut -c1-400)"
  rm -f "$response"
  return 1
}

cmd_session() {
  local hosts="${1:-}" token tenant body response code id file
  for tool in curl jq; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_credentials
  mkdir -p "$SESSIONS_DIR"
  tenant=$(cred VGS_TENANT)
  token=$(access_token)
  report_account_scopes "$token"

  # AWG_CARD_STORE=aliases skips the Cards API, for tenants without it.
  if [ "${AWG_CARD_STORE:-}" != aliases ] && store_test_card "$token"; then
    say "Stored the VGS test card (4111 … 1111) and got fresh aliases."
  elif store_test_aliases "$token" "$tenant"; then
    say "Stored the test card (4111 … 1111) through the alias API. The session has the number and the CVC; this is not an error and nothing else is needed."
    if [ -n "${CARD_ERROR:-}" ]; then
      say "  For reference, the Cards API was not used because it answered $CARD_ERROR."
      explain_card_refusal "$token" "$tenant"
    fi
  elif [ -f "$CARD_FILE" ]; then
    jq '.fresh = false' "$CARD_FILE" > "$CARD_FILE.tmp" && mv "$CARD_FILE.tmp" "$CARD_FILE"
    say "Could not store the test card just now (Cards API: $CARD_ERROR; alias API: $ALIAS_ERROR)."
    explain_card_refusal "$token" "$tenant"
    say "Using the card number alias saved earlier (no CVC)."
  else
    say "Cards API answered: $CARD_ERROR"
    say "Alias API answered: $ALIAS_ERROR"
    explain_card_refusal "$token" "$tenant"
    fail "could not store a test card with either API.
       Or save your own aliases as $CARD_FILE:
       {\"pan_alias\": \"tok_sandbox_…\", \"bin\": \"411111\", \"length\": 16}"
  fi

  body=$(jq -n --arg hosts "$hosts" --slurpfile c "$CARD_FILE" '
    ($c[0]) as $card
    | {label: "main", number: {alias: $card.pan_alias, bin: $card.bin, length: $card.length}}
      + (if $card.fresh == true and $card.cvc_alias then {cvc: {alias: $card.cvc_alias, length: 3, storage: "VOLATILE"}} else {} end) as $entry
    | {data: {type: "reveal-sessions", attributes:
        ({cards: [$entry]} + (if $hosts == "" then {} else {allowed_hosts: ($hosts | split(","))} end))}}')
  response=$(mktemp "$SESSIONS_DIR/new.XXXXXX")
  code=$(curl -sS -o "$response" -w '%{http_code}' "$API/reveal-sessions" \
    -H "Authorization: Bearer $token" -H "VGS-Tenant: $tenant" \
    -H 'Content-Type: application/vnd.api+json' -d "$body") || code=000
  if [ "$code" != 201 ]; then
    say "VGS answered HTTP $code:"
    jq -c '.errors // .' "$response" 2>/dev/null | cut -c1-500 || true
    rm -f "$response"
    [ "$code" != 403 ] || say "A 403 here means the service account lacks reveal-sessions:write, or Agent Web Gateway is not enabled for tenant $tenant."
    fail "the session was not created."
  fi
  id=$(jq -r .data.id "$response")
  file="$SESSIONS_DIR/$id.json"
  mv "$response" "$file"
  printf '%s' "$file" > "$LATEST"
  jq '{id: .data.id, expires_at: .data.attributes.expires_at, allowed_hosts: (.data.attributes.allowed_hosts // []),
       unlisted_host_mode: .data.attributes.unlisted_host_mode}' "$file"
  say "Session saved to $file"
}

# ---------------------------------------------------------------- panel / browser

cmd_panel() {
  [ -f "$PANEL_DIR/start-proxy-controls.py" ] || fail "control panel not found in $PANEL_DIR"
  kit_python "$PANEL_DIR/start-proxy-controls.py" "$@"
}

cmd_browser() {
  have openssl || fail "openssl is required to trust the session's certificate. Install it with your package manager."
  cloak_python python "$KIT_DIR/tools/cloak/launch-panel.py" "$@"
}

cmd_cloak_login() {
  say "CloakBrowser needs a license key. The free tier allows one browser at a time."
  say "Get a key at https://github.com/CloakHQ/CloakBrowser, then paste it below."
  cloak_python cloakbrowser login
}

# A browser left open by an earlier ./awg start still holds the profile, so a second one cannot start.
close_earlier_browser() {
  local lock pid answer=""
  lock=$(readlink "$PROFILE_DIR/SingletonLock" 2>/dev/null) || return 0
  pid=${lock##*-}
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  ps -p "$pid" -o command= 2>/dev/null | grep -qF -- "--user-data-dir=$PROFILE_DIR" || return 0
  say "CloakBrowser from an earlier ./awg start is still open. Only one can run at a time."
  [ -t 0 ] || fail "close that browser window, then run ./awg start again."
  read -r -p "Close it and continue? [Y/n] " answer
  case "$answer" in
    ""|y|Y|yes|Yes) ;;
    *) fail "left it open. Close that browser window, then run ./awg start again." ;;
  esac
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.5; done
  fail "that browser did not close. Quit it yourself, then run ./awg start again."
}

cmd_start() {
  local url="${1:-}" host="" session helper_pid extension
  for tool in curl jq openssl; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_uv
  [ -f "$CREDENTIALS" ] || AWG_IN_START=1 cmd_setup
  need_cloak_license
  close_earlier_browser
  [ -z "$url" ] || host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#[/:?].*$##')
  session=$(latest_session)
  if session_alive "$session" && { [ -z "$host" ] || jq -e --arg h "$host" '(.data.attributes.allowed_hosts // []) | index($h)' "$session" >/dev/null; }; then
    say "Using the current session: $(basename "$session" .json)"
  else
    say "Creating a reveal session${host:+ for $host}..."
    cmd_session "$host"
    session=$(latest_session)
  fi

  say ""
  say "Starting the control panel helper..."
  : > "$HELPER_LOG"
  # The browser profile keeps an extension's background worker for as long as the extension keeps
  # its identity, and that worker holds one start's helper address and session. An unpacked
  # extension's identity is its folder, so each start generates the panel into a new one.
  rm -rf "$STATE_DIR/panel-extension"
  extension="$STATE_DIR/panel-extension/$(date +%s)-$$"
  mkdir -p "$STATE_DIR/panel-extension"
  chmod 700 "$STATE_DIR/panel-extension"
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
    python "$PANEL_DIR/start-proxy-controls.py" --session "$session" --output "$extension" \
    --credentials-file "$CREDENTIALS" --sessions-dir "$SESSIONS_DIR" --exit-with-pid "$$" > "$HELPER_LOG" 2>&1 &
  helper_pid=$!
  # Capture the PID now: EXIT runs after this function's locals leave scope. uv runs the helper as
  # a child, so stop that too; --exit-with-pid covers the case where this script is killed outright.
  trap "pkill -P '$helper_pid' 2>/dev/null || true; kill '$helper_pid' 2>/dev/null || true; wait '$helper_pid' 2>/dev/null || true; rm -rf '$STATE_DIR/panel-extension'" EXIT
  for _ in $(seq 1 60); do
    grep -q 'Proxy controls are ready' "$HELPER_LOG" 2>/dev/null && break
    kill -0 "$helper_pid" 2>/dev/null || { fail "the control panel helper stopped. Inspect the private log at $HELPER_LOG locally."; }
    sleep 0.5
  done
  grep -q 'Proxy controls are ready' "$HELPER_LOG" || { fail "the control panel helper did not become ready in 30 seconds. Inspect $HELPER_LOG locally."; }
  say "Helper is running. Opening CloakBrowser..."
  say ""
  if [ -n "$url" ]; then cmd_browser --profile "$PROFILE_DIR" --extension "$extension" --session "$session" "$url"; else cmd_browser --profile "$PROFILE_DIR" --extension "$extension" --session "$session"; fi
}

# ---------------------------------------------------------------- Kernel cloud browser

KERNEL_API="${KERNEL_API_URL:-https://api.onkernel.com}"
KERNEL_CODE=""; KERNEL_BODY=""

kernel_call() {  # kernel_call <method> <path> [json body]; sets KERNEL_CODE and KERNEL_BODY (a private file)
  [ -n "$KERNEL_BODY" ] || KERNEL_BODY=$(mktemp "$STATE_DIR/kernel.XXXXXX")
  # The body carries the session's proxy password, so it goes over stdin, not the command line.
  KERNEL_CODE=$(printf '%s' "${3:-}" | curl -sS -o "$KERNEL_BODY" -w '%{http_code}' -X "$1" "$KERNEL_API$2" \
    -H "Authorization: Bearer $KERNEL_API_KEY" -H 'Content-Type: application/json' ${3:+--data-binary @-}) || KERNEL_CODE=000
}

kernel_refused() {  # kernel_refused <what was attempted>
  say "Kernel answered HTTP $KERNEL_CODE:"
  jq -c '{code, message} | with_entries(select(.value != null))' "$KERNEL_BODY" 2>/dev/null | cut -c1-400 || true
  [ "$KERNEL_CODE" != 401 ] || say "Kernel did not accept KERNEL_API_KEY. Check the key in your Kernel account."
  fail "$1"
}

# Kernel (kernel.sh) runs the browser in its cloud. The reveal session's proxy and certificate are
# registered there as a custom proxy, so the browser's traffic passes through the same session.
cmd_kernel() {
  local url="${1:-}" host="" session body proxy_id browser_id live
  for tool in curl jq; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  [ -n "${KERNEL_API_KEY:-}" ] || fail "KERNEL_API_KEY is not set. Create an API key in your Kernel account (https://kernel.sh), then run:
       KERNEL_API_KEY=… ./awg kernel"
  [ -f "$CREDENTIALS" ] || AWG_IN_START=1 cmd_setup
  [ -z "$url" ] || host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#[/:?].*$##')
  session=$(latest_session)
  if session_alive "$session" && { [ -z "$host" ] || jq -e --arg h "$host" '(.data.attributes.allowed_hosts // []) | index($h)' "$session" >/dev/null; }; then
    say "Using the current session: $(basename "$session" .json)"
  else
    say "Creating a reveal session${host:+ for $host}..."
    cmd_session "$host"
    session=$(latest_session)
  fi

  body=$(jq --arg name "awg-$(basename "$session" .json)-$(date +%s)" '
    def unpct: gsub("%(?<h>[0-9A-Fa-f]{2})"; (.h | ascii_downcase | explode
      | map(if . > 96 then . - 87 else . - 48 end) | [.[0] * 16 + .[1]] | implode));
    .data.attributes.proxy as $p
    | ($p.url | capture("^(?<scheme>https?)://(?<user>[^:@/]+):(?<pass>[^@/]+)@(?<host>[^:/@]+):(?<port>[0-9]+)")) as $u
    | {type: "custom", name: $name, protocol: $u.scheme,
       config: {host: $u.host, port: ($u.port | tonumber), username: ($u.user | unpct),
                password: ($u.pass | unpct), ca_bundle: $p.ca_bundle}}' "$session" 2>/dev/null) \
    || fail "the saved session has no usable proxy details. Create a new one with ./awg session"

  say ""
  say "Registering the session with Kernel as a custom proxy..."
  trap 'rm -f "$KERNEL_BODY"' EXIT
  kernel_call POST /proxies "$body"
  [ "$KERNEL_CODE" = 201 ] || [ "$KERNEL_CODE" = 200 ] || kernel_refused "Kernel did not create the proxy."
  proxy_id=$(jq -r '.id // empty' "$KERNEL_BODY")
  [ -n "$proxy_id" ] || fail "Kernel returned no proxy id."
  # The proxy entry holds this session's credentials, so it is removed again on the way out.
  trap "kernel_call DELETE '/proxies/$proxy_id'; rm -f \"\$KERNEL_BODY\"" EXIT

  say "Starting a Kernel browser..."
  kernel_call POST /browsers "$(jq -n --arg id "$proxy_id" --arg url "$url" \
    '{proxy: {id: $id}, timeout_seconds: 1800} + (if $url == "" then {} else {start_url: $url} end)')"
  [ "$KERNEL_CODE" = 201 ] || [ "$KERNEL_CODE" = 200 ] || kernel_refused "Kernel did not start the browser."
  browser_id=$(jq -r '.session_id // empty' "$KERNEL_BODY")
  live=$(jq -r '.browser_live_view_url // empty' "$KERNEL_BODY")
  [ -n "$browser_id" ] || fail "Kernel returned no browser session id."
  trap "kernel_call DELETE '/browsers/$browser_id'; kernel_call DELETE '/proxies/$proxy_id'; rm -f \"\$KERNEL_BODY\"" EXIT

  say ""
  say "A Kernel browser is running through session $(basename "$session" .json)."
  # Kernel's own identifiers, for Kernel support.
  say "Kernel browser session: $browser_id"
  say "Kernel proxy: $proxy_id"
  if [ -n "$live" ]; then
    say "Watch and control it here (keep this link private; it controls the browser):"
    say "  $live"
  else
    say "Kernel returned no live view link. Open the browser from your Kernel dashboard."
  fi
  say ""
  if [ -t 0 ]; then
    read -r -p "Press Enter to close the Kernel browser and remove the proxy. " _ || true
  else
    say "This command runs until the Kernel browser closes (30 minutes idle) or it is stopped."
    while kernel_call GET "/browsers/$browser_id"; [ "$KERNEL_CODE" = 200 ]; do sleep 30; done
  fi
  say "Closing the Kernel browser and removing the proxy..."
}

cmd_sitecheck() {
  need_uv
  (cd "$SITECHECK_DIR" && uv run awg-sitecheck "$@")
}

usage() { sed -n '2,15p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  test)        shift; cmd_test "$@" ;;
  setup)       shift; cmd_setup "$@" ;;
  session)     shift; cmd_session "$@" ;;
  start)       shift; cmd_start "$@" ;;
  kernel)      shift; cmd_kernel "$@" ;;
  panel)       shift; cmd_panel "$@" ;;
  browser)     shift; cmd_browser "$@" ;;
  cloak-login) shift; cmd_cloak_login "$@" ;;
  sitecheck)   shift; cmd_sitecheck "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; fail "unknown command: $1" ;;
esac
