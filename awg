#!/usr/bin/env bash
# One entry point for the Agent Web Gateway dev kit.
#
#   ./awg doctor               check this machine is ready
#   ./awg test                 run the kit's offline tests (no credentials, nothing sent to VGS)
#   ./awg setup                save your Sandbox credentials (asks at hidden prompts)
#   ./awg session [hosts]      create a reveal session for a test card (hosts: comma-separated)
#   ./awg start [url]          one step: session + control panel helper + CloakBrowser
#   ./awg panel [options]      start only the control panel helper (options of start-proxy-controls.py)
#   ./awg browser [options]    open only CloakBrowser with the control panel (--session FILE [url])
#   ./awg cloak-login          save your CloakBrowser license key (once)
#   ./awg sitecheck [args]     run the awg-sitecheck tool (arguments of awg-sitecheck)
#
# The only thing to install is uv (https://docs.astral.sh/uv/). It supplies the right
# Python by itself. Your private files live in ~/.awg-dev-kit, readable only by you.
set -euo pipefail
umask 077

KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANEL_DIR="$KIT_DIR/tools/vgs-proxy-controls"
SITECHECK_DIR="$KIT_DIR/tools/sitecheck"
PYTHON_VERSION="3.12"

STATE_DIR="${AWG_HOME:-$HOME/.awg-dev-kit}"
CREDENTIALS="$STATE_DIR/sandbox.env"
SESSIONS_DIR="$STATE_DIR/sessions"
CARD_FILE="$STATE_DIR/card.json"
LATEST="$STATE_DIR/latest-session"
HELPER_LOG="$STATE_DIR/helper.log"
PROFILE_DIR="$STATE_DIR/cloak-profile"

API="https://sandbox.vgsapi.com"
AUTH="https://auth.verygoodsecurity.com/auth/realms/vgs/protocol/openid-connect/token"

say()  { printf '%s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

need_uv() {
  have uv && return
  local answer=""
  if [ -t 0 ]; then
    read -r -p "This kit needs uv (it supplies Python and the browser). Install it now? [Y/n] " answer
    case "$answer" in
      ""|y|Y|yes|Yes)
        if have brew; then brew install uv; else curl -LsSf https://astral.sh/uv/install.sh | sh; fi
        export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
        have uv && return
        ;;
    esac
  fi
  fail "uv is not installed. Install it with:  brew install uv
       (or: curl -LsSf https://astral.sh/uv/install.sh | sh), then run this again."
}

# CloakBrowser needs a license key on every launch; ask for it once.
need_cloak_license() {
  [ -n "${CLOAKBROWSER_LICENSE_KEY:-}" ] && return
  [ -s "$HOME/.cloakbrowser/license.key" ] && return
  if [ -t 0 ]; then cmd_cloak_login; else fail "CloakBrowser needs a license key. Run './awg cloak-login' in your own terminal."; fi
}

# Run Python from the kit with the pinned version. uv downloads it on first use.
kit_python() {
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" python "$@"
}

# CloakBrowser is installed on demand by uv; nothing to set up beyond a license key.
cloak_python() {
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" --with cloakbrowser "$@"
}

# ---------------------------------------------------------------- doctor / test

check() {  # check <label> <command> <hint>
  if have "$2"; then
    say "  ok       $1"
  else
    say "  MISSING  $1  ->  $3"
    MISSING=1
  fi
}

cmd_doctor() {
  MISSING=0
  say "Checking this machine:"
  check "uv (supplies Python $PYTHON_VERSION)" uv      "brew install uv"
  check "curl"                                 curl    "install curl with your package manager"
  check "jq"                                   jq      "brew install jq"
  check "openssl"                              openssl "install openssl with your package manager"
  if have node; then
    say "  ok       node (optional: extension tests)"
  else
    say "  skipped  node (optional: only './awg test' uses it, for the extension tests)"
  fi
  if have uv; then
    if version=$(kit_python --version 2>/dev/null); then
      say "  ok       $version, provided by uv"
    else
      say "  MISSING  Python $PYTHON_VERSION  ->  uv could not provide it; check your network and run: uv python install $PYTHON_VERSION"
      MISSING=1
    fi
  fi
  if [ -f "$CREDENTIALS" ]; then
    say "  ok       Sandbox credentials saved ($CREDENTIALS)"
  else
    say "  todo     Sandbox credentials  ->  ./awg setup"
  fi
  say ""
  [ "$MISSING" = 0 ] || fail "install what is marked MISSING, then run ./awg doctor again."
  if [ -f "$CREDENTIALS" ]; then say "Ready. Next: ./awg start"; else say "Ready. Next: ./awg start  (it asks for your Sandbox credentials the first time)"; fi
}

cmd_test() {
  say "Control panel helper tests (Python $PYTHON_VERSION)..."
  (cd "$PANEL_DIR" && kit_python -m unittest discover -p 'test_*.py')
  if have node; then
    say ""
    say "Extension tests (node)..."
    (cd "$PANEL_DIR" && node --test test_session_proxy_extension.mjs)
  else
    say ""
    say "Skipped the extension tests: node is not installed."
  fi
}

# ---------------------------------------------------------------- credentials

cred() { grep -E "^$1=" "$CREDENTIALS" | head -1 | cut -d= -f2-; }

need_credentials() {
  [ -f "$CREDENTIALS" ] || fail "no saved credentials. Run:  ./awg setup"
}

access_token() {
  local token
  token=$(curl -sS -X POST "$AUTH" -d grant_type=client_credentials \
    --data-urlencode "client_id=$(cred VGS_CLIENT_ID)" \
    --data-urlencode "client_secret=$(cred VGS_CLIENT_SECRET)" | jq -r '.access_token // empty') || true
  [ -n "$token" ] || fail "VGS did not issue an access token. Check the client id and secret, then run ./awg setup --force"
  printf '%s' "$token"
}

cmd_setup() {
  local force=0 from=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --from)  shift; from="${1:-}" ;;
      *) fail "unknown option for setup: $1" ;;
    esac
    shift
  done
  for tool in curl jq; do have "$tool" || fail "$tool is required. Run ./awg doctor"; done
  mkdir -p "$SESSIONS_DIR"
  if [ -f "$CREDENTIALS" ] && [ "$force" = 0 ]; then
    say "Credentials are already saved in $CREDENTIALS (tenant $(cred VGS_TENANT))."
    say "To replace them: ./awg setup --force"
    return
  fi

  local tenant="${VGS_TENANT:-}" client_id="${VGS_CLIENT_ID:-}" client_secret="${VGS_CLIENT_SECRET:-}"
  if [ -n "$from" ]; then
    [ -f "$from" ] || fail "no file at $from"
    line() { grep -E "^(export )?$1=" "$from" | head -1 | sed -E "s/^(export )?$1=//; s/^[\"']//; s/[\"']\$//"; }
    tenant=$(line VGS_TENANT); client_id=$(line VGS_CLIENT_ID); client_secret=$(line VGS_CLIENT_SECRET)
  fi
  if [ -z "$tenant" ] || [ -z "$client_id" ] || [ -z "$client_secret" ]; then
    if [ ! -t 0 ]; then
      fail "this needs a terminal for the hidden prompts. Run './awg setup' in your own terminal,
       or pass an existing file:  ./awg setup --from /path/to/file.env
       (lines VGS_TENANT=, VGS_CLIENT_ID=, VGS_CLIENT_SECRET=)."
    fi
    say "Enter your VGS Sandbox service account. Nothing you type is shown or sent anywhere but VGS."
    read -r  -p "Tenant id (starts with tnt): " tenant
    read -r  -p "Client id: " client_id
    read -rs -p "Client secret (hidden): " client_secret; say ""
  fi
  [[ "$tenant" =~ ^tnt[A-Za-z0-9]+$ ]] || fail "that tenant id does not look right; it starts with 'tnt'."
  [ -n "$client_id" ] && [ -n "$client_secret" ] || fail "the client id and secret are both required."

  printf 'VGS_TENANT=%s\nVGS_CLIENT_ID=%s\nVGS_CLIENT_SECRET=%s\nVGS_API=%s\nVGS_AUTH_URL=%s\n' \
    "$tenant" "$client_id" "$client_secret" "$API" "$AUTH" > "$CREDENTIALS"
  unset client_secret
  access_token >/dev/null
  say "Saved to $CREDENTIALS and verified with VGS (tenant $tenant)."
  [ "${AWG_IN_START:-}" = 1 ] || say "Next: ./awg start"
}

# ---------------------------------------------------------------- session

session_alive() {  # session_alive <file>
  [ -f "$1" ] && jq -e '(.data.attributes.expires_at | fromdateiso8601) > (now + 60)' "$1" >/dev/null 2>&1
}

latest_session() { [ -f "$LATEST" ] && cat "$LATEST" || true; }

# Stores the standard VGS test card so the session has fresh aliases. Never a real card.
store_test_card() {  # store_test_card <token>
  local response code year
  response=$(mktemp "$STATE_DIR/card.XXXXXX")
  year=$(( ($(date +%Y) + 3) % 100 ))   # the cards API takes a two-digit year
  code=$(curl -sS -o "$response" -w '%{http_code}' -X POST "$API/cards" \
    -H "Authorization: Bearer $1" -H 'Content-Type: application/vnd.api+json' -H 'Accept: application/vnd.api+json' \
    -d "$(jq -n --argjson y "$year" '{data:{attributes:{pan:"4111111111111111",cvc:"123",exp_month:12,exp_year:$y}}}')") || code=000
  if { [ "$code" = 201 ] || [ "$code" = 303 ]; } && jq -e '.data.attributes.pan_alias' "$response" >/dev/null 2>&1; then
    jq '.data | {card_id: .id, pan_alias: .attributes.pan_alias, cvc_alias: .attributes.cvc_alias,
                 bin: (.attributes.bin // "411111"), length: 16, fresh: true}' "$response" > "$CARD_FILE"
    rm -f "$response"
    return 0
  fi
  CARD_ERROR="HTTP $code $(jq -c '[.errors[]? | {code, title, detail}] // .' "$response" 2>/dev/null | cut -c1-400)"
  rm -f "$response"
  return 1
}

cmd_session() {
  local hosts="${1:-}" token tenant body response code id file
  for tool in curl jq; do have "$tool" || fail "$tool is required. Run ./awg doctor"; done
  need_credentials
  mkdir -p "$SESSIONS_DIR"
  tenant=$(cred VGS_TENANT)
  token=$(access_token)

  if store_test_card "$token"; then
    say "Stored the VGS test card (4111 … 1111) and got fresh aliases."
  elif [ -f "$CARD_FILE" ]; then
    jq '.fresh = false' "$CARD_FILE" > "$CARD_FILE.tmp" && mv "$CARD_FILE.tmp" "$CARD_FILE"
    say "Could not store the test card just now ($CARD_ERROR); using the card number alias saved earlier (no CVC)."
  else
    say "VGS answered: $CARD_ERROR"
    fail "could not store a test card. The service account may lack permission to create cards (POST /cards).
       Ask your VGS contact, or save your own aliases as $CARD_FILE:
       {\"pan_alias\": \"tok_sandbox_…\", \"bin\": \"411111\", \"length\": 16}"
  fi

  body=$(jq -n --arg hosts "$hosts" --slurpfile c "$CARD_FILE" '
    ($c[0]) as $card
    | {label: "main", number: {alias: $card.pan_alias, bin: $card.bin, length: $card.length}}
      + (if $card.fresh == true and $card.cvc_alias then {cvc: {alias: $card.cvc_alias, length: 3, storage: "VOLATILE"}} else {} end) as $entry
    | {data: {type: "reveal-sessions", attributes:
        ({cards: [$entry]} + (if $hosts == "" then {} else {allowed_hosts: ($hosts | split(","))} end))}}')
  response=$(mktemp "$SESSIONS_DIR/new.XXXXXX")
  code=$(curl -sS -o "$response" -w '%{http_code}' "$API/reveal-sessions" \
    -H "Authorization: Bearer $token" -H "VGS-Tenant: $tenant" \
    -H 'Content-Type: application/vnd.api+json' -d "$body") || code=000
  if [ "$code" != 201 ]; then
    say "VGS answered HTTP $code:"
    jq -c '.errors // .' "$response" 2>/dev/null | cut -c1-500 || true
    rm -f "$response"
    fail "the session was not created."
  fi
  id=$(jq -r .data.id "$response")
  file="$SESSIONS_DIR/$id.json"
  mv "$response" "$file"
  printf '%s' "$file" > "$LATEST"
  jq '{id: .data.id, expires_at: .data.attributes.expires_at, allowed_hosts: (.data.attributes.allowed_hosts // []),
       unlisted_host_mode: .data.attributes.unlisted_host_mode}' "$file"
  say "Session saved to $file"
}

# ---------------------------------------------------------------- panel / browser

cmd_panel() {
  [ -f "$PANEL_DIR/start-proxy-controls.py" ] || fail "control panel not found in $PANEL_DIR"
  kit_python "$PANEL_DIR/start-proxy-controls.py" "$@"
}

cmd_browser() {
  have openssl || fail "openssl is required to trust the session's certificate. Run ./awg doctor"
  cloak_python python "$KIT_DIR/tools/cloak/launch-panel.py" "$@"
}

cmd_cloak_login() {
  say "CloakBrowser needs a license key. The free tier allows one browser at a time."
  say "Get a key at https://github.com/CloakHQ/CloakBrowser, then paste it below."
  cloak_python cloakbrowser login
}

# A browser left open by an earlier ./awg start still holds the profile, so a second one cannot start.
close_earlier_browser() {
  local lock pid answer=""
  lock=$(readlink "$PROFILE_DIR/SingletonLock" 2>/dev/null) || return 0
  pid=${lock##*-}
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  ps -p "$pid" -o command= 2>/dev/null | grep -qF -- "--user-data-dir=$PROFILE_DIR" || return 0
  say "CloakBrowser from an earlier ./awg start is still open. Only one can run at a time."
  [ -t 0 ] || fail "close that browser window, then run ./awg start again."
  read -r -p "Close it and continue? [Y/n] " answer
  case "$answer" in
    ""|y|Y|yes|Yes) ;;
    *) fail "left it open. Close that browser window, then run ./awg start again." ;;
  esac
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.5; done
  fail "that browser did not close. Quit it yourself, then run ./awg start again."
}

cmd_start() {
  local url="${1:-}" host="" session helper_pid
  for tool in curl jq openssl; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_uv
  [ -f "$CREDENTIALS" ] || AWG_IN_START=1 cmd_setup
  need_cloak_license
  close_earlier_browser
  [ -z "$url" ] || host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#[/:?].*$##')
  session=$(latest_session)
  if session_alive "$session" && { [ -z "$host" ] || jq -e --arg h "$host" '(.data.attributes.allowed_hosts // []) | index($h)' "$session" >/dev/null; }; then
    say "Using the current session: $(basename "$session" .json)"
  else
    say "Creating a reveal session${host:+ for $host}..."
    cmd_session "$host"
    session=$(latest_session)
  fi

  say ""
  say "Starting the control panel helper..."
  : > "$HELPER_LOG"
  kit_python "$PANEL_DIR/start-proxy-controls.py" --session "$session" \
    --credentials-file "$CREDENTIALS" --sessions-dir "$SESSIONS_DIR" > "$HELPER_LOG" 2>&1 &
  helper_pid=$!
  trap 'kill "$helper_pid" 2>/dev/null || true' EXIT
  for _ in $(seq 1 60); do
    grep -q 'Proxy controls are ready' "$HELPER_LOG" 2>/dev/null && break
    kill -0 "$helper_pid" 2>/dev/null || { cat "$HELPER_LOG"; fail "the control panel helper stopped. Its message is above."; }
    sleep 0.5
  done
  grep -q 'Proxy controls are ready' "$HELPER_LOG" || { cat "$HELPER_LOG"; fail "the control panel helper did not become ready in 30 seconds."; }
  say "Helper is running. Opening CloakBrowser..."
  say ""
  if [ -n "$url" ]; then cmd_browser --profile "$PROFILE_DIR" --session "$session" "$url"; else cmd_browser --profile "$PROFILE_DIR" --session "$session"; fi
}

cmd_sitecheck() {
  need_uv
  (cd "$SITECHECK_DIR" && uv run awg-sitecheck "$@")
}

usage() { sed -n '2,16p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  doctor)      shift; cmd_doctor "$@" ;;
  test)        shift; cmd_test "$@" ;;
  setup)       shift; cmd_setup "$@" ;;
  session)     shift; cmd_session "$@" ;;
  start)       shift; cmd_start "$@" ;;
  panel)       shift; cmd_panel "$@" ;;
  browser)     shift; cmd_browser "$@" ;;
  cloak-login) shift; cmd_cloak_login "$@" ;;
  sitecheck)   shift; cmd_sitecheck "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; fail "unknown command: $1" ;;
esac
