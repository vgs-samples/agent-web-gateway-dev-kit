#!/usr/bin/env bash
# One entry point for the Agent Web Gateway dev kit.
#
#   ./awg test                 run the kit's offline tests (no credentials, nothing sent to VGS)
#   ./awg setup [--organization AC…]  log in and provision Sandbox credentials
#   ./awg credentials [dev|sandbox|live]  list saved credential files (never their contents)
#   ./awg session [hosts]      create a reveal session for a test card (hosts: comma-separated)
#   ./awg start [url]          one step: session + control panel helper + CloakBrowser
#   ./awg kernel [url]         session + a Kernel cloud browser routed through it (asks for your Kernel API key once)
#   ./awg <provider>-login     save or replace an API key: kernel-login, browser-use-login, browserbase-login
#   ./awg browser-use [url]    ./awg start, plus a Chrome DevTools address for a Browser Use agent (--cloud: their cloud browser; asks for your API key once)
#   ./awg browserbase [url]    session + a Browserbase cloud browser routed through it (asks for your Browserbase API key once)
#   ./awg panel [options]      start only the control panel helper (options of start-proxy-controls.py)
#   ./awg browser [options]    open only CloakBrowser with the control panel (--session FILE [url])
#   ./awg cloak-login          save your CloakBrowser license key (once)
#   ./awg sitecheck [args]     run the awg-sitecheck tool (arguments of awg-sitecheck)
#
# uv supplies Python for the kit, the browser and VGS CLI; nothing is compiled.
# Private files live in ~/.vgs/awg/{dev,sandbox,live}, readable only by you.
set -euo pipefail
umask 077

KIT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PANEL_DIR="$KIT_DIR/tools/vgs-proxy-controls"
SITECHECK_DIR="$KIT_DIR/tools/sitecheck"
PYTHON_VERSION="3.12"
VGS_CLI_VERSION="1.37.0"

AWG_ROOT="${AWG_HOME:-$HOME/.vgs/awg}"
ENVIRONMENT="${AWG_ENVIRONMENT:-sandbox}"
case "$ENVIRONMENT" in
  dev) DOMAIN=io ;;
  sandbox|live) DOMAIN=com ;;
  *) printf 'error: AWG_ENVIRONMENT must be dev, sandbox, or live\n' >&2; exit 1 ;;
esac
STATE_DIR="$AWG_ROOT/$ENVIRONMENT"
CREDENTIALS="$STATE_DIR/$ENVIRONMENT.env"
SESSIONS_DIR="$STATE_DIR/sessions"
CARD_FILE="$STATE_DIR/card.json"
LATEST="$STATE_DIR/latest-session"
EGRESS_FILE="$STATE_DIR/.proxy-controls-egress.json"
HELPER_LOG="$STATE_DIR/helper.log"
PROFILE_DIR="$STATE_DIR/cloak-profile"

API="https://sandbox.vgsapi.$DOMAIN"
[ "$ENVIRONMENT" != live ] || API="https://vgsapi.com"
AUTH="https://auth.verygoodsecurity.$DOMAIN/auth/realms/vgs/protocol/openid-connect/token"

say()  { printf '%s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

need_uv() {
  have uv && return
  say "Installing uv for the kit runtime..."
  if have brew; then
    brew install uv
  else
    have curl || fail "curl is required to install uv. Install it with your package manager."
    local installer
    installer=$(mktemp)
    curl -fsSL https://astral.sh/uv/install.sh -o "$installer" || { rm -f "$installer"; fail "could not download uv installer"; }
    sh "$installer" || { rm -f "$installer"; fail "uv installation failed"; }
    rm -f "$installer"
  fi
  export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"
  have uv || fail "uv installation did not put uv on PATH. See https://docs.astral.sh/uv/getting-started/installation/"
}

# CloakBrowser needs a license key on every launch; ask for it once.
need_cloak_license() {
  [ -n "${CLOAKBROWSER_LICENSE_KEY:-}" ] && return
  [ -s "$HOME/.cloakbrowser/license.key" ] && return
  if [ -t 0 ]; then cmd_cloak_login; else fail "CloakBrowser needs a license key. Run './awg cloak-login' in your own terminal."; fi
}

# Run Python from the kit with the pinned version. uv downloads it on first use.
kit_python() {
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" python "$@"
}

# CloakBrowser is installed on demand by uv; nothing to set up beyond a license key.
cloak_python() {
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" --with cloakbrowser "$@"
}

# VGS CLI gets a private environment on a prebuilt Python from uv, never an arbitrary vgs on PATH.
# Nothing is compiled, so setup does not depend on the machine's compiler or OpenSSL.
need_vgs_cli() {
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  need_uv
  CLI_ENV="$STATE_DIR/vgs-cli-$VGS_CLI_VERSION-uv-py$PYTHON_VERSION"
  if [ ! -x "$CLI_ENV/bin/vgs" ]; then
    say "Installing VGS CLI $VGS_CLI_VERSION (private to this kit)..."
    rm -rf "$CLI_ENV"
    uv venv --quiet --python "$PYTHON_VERSION" "$CLI_ENV" || fail "uv could not prepare Python $PYTHON_VERSION for VGS CLI. Check your network connection and retry."
    uv pip install --quiet --python "$CLI_ENV/bin/python" "vgs-cli==$VGS_CLI_VERSION" || { rm -rf "$CLI_ENV"; fail "could not install VGS CLI $VGS_CLI_VERSION from PyPI. Check your network connection and retry."; }
  fi
  # Local help validates the installed command surface without authentication.
  # The first run compiles the CLI; keep its own SyntaxWarning out of the developer's terminal.
  env -u VGS_CLIENT_ID -u VGS_CLIENT_SECRET PYTHONWARNINGS=ignore::SyntaxWarning "$CLI_ENV/bin/vgs" get tenants --help >/dev/null
  env -u VGS_CLIENT_ID -u VGS_CLIENT_SECRET PYTHONWARNINGS=ignore::SyntaxWarning "$CLI_ENV/bin/vgs" apply service-account --help >/dev/null
}

# ---------------------------------------------------------------- offline tests

cmd_test() {
  say "Bootstrap and CLI tests (offline synthetic fixtures)..."
  need_uv
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" --with PyYAML==6.0.3 \
    python -m unittest discover -s "$KIT_DIR/tests" -p 'test_*.py'
  say "Control panel helper tests (Python $PYTHON_VERSION)..."
  (cd "$PANEL_DIR" && kit_python -m unittest discover -p 'test_*.py')
  if have node; then
    say ""
    say "Extension tests (node)..."
    (cd "$PANEL_DIR" && node --test test_session_proxy_extension.mjs)
  else
    say ""
    say "Skipped the extension tests: node is not installed."
  fi
}

# ---------------------------------------------------------------- credentials

cmd_credentials() {
  case "${1:-}" in
    ""|dev|sandbox|live) ;;
    --help|-h) say "Usage: ./awg credentials [dev|sandbox|live]
List saved service-account files under ~/.vgs/awg (AWG_HOME overrides the root).
Supports environment files, dashboard exports and CLI YAML/JSON. Secrets are never shown."; return ;;
    *) fail "credentials expects dev, sandbox, or live" ;;
  esac
  [ $# -le 1 ] || fail "credentials accepts at most one environment"
  kit_python "$PANEL_DIR/saved_accounts.py" "$@"
}

cred() { grep -E "^$1=" "$CREDENTIALS" | head -1 | cut -d= -f2-; }

need_credentials() {
  if [ ! -f "$CREDENTIALS" ]; then
    cmd_credentials "$ENVIRONMENT" >&2
    fail "no saved credentials at $CREDENTIALS. Run ./awg setup for Sandbox; save an existing DEV account as dev.env for DEV."
  fi
  local configured_api configured_auth configured_environment
  configured_api=$(cred VGS_API || true)
  configured_auth=$(cred VGS_AUTH_URL || true)
  configured_environment=$(cred VGS_ENVIRONMENT || true)
  [ -z "$configured_api" ] || [ "$configured_api" = "$API" ] || fail "credentials do not match AWG_ENVIRONMENT"
  [ -z "$configured_auth" ] || [ "$configured_auth" = "$AUTH" ] || fail "credential authentication endpoint does not match AWG_ENVIRONMENT"
  [ -z "$configured_environment" ] || [ "$configured_environment" = "$ENVIRONMENT" ] || fail "credentials do not match AWG_ENVIRONMENT"
}

ensure_credentials() {
  if [ ! -f "$CREDENTIALS" ] && [ "$ENVIRONMENT" = sandbox ]; then
    AWG_IN_START=1 cmd_setup
  fi
  need_credentials
}

access_token() {
  local token
  token=$(curl -sS -X POST "$AUTH" -d grant_type=client_credentials \
    --data-urlencode "client_id=$(cred VGS_CLIENT_ID)" \
    --data-urlencode "client_secret=$(cred VGS_CLIENT_SECRET)" | jq -r '.access_token // empty') || true
  [ -n "$token" ] || fail "VGS did not issue an access token. Check the client id and secret, then run ./awg setup --force"
  printf '%s' "$token"
}

cmd_setup() {
  # Validate flags before downloading anything or opening login.
  local arg
  local -a SETUP_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --help|-h) say "Usage: ./awg setup [--organization AC…] [--tenant tnt…] [--force]
Log in with VGS, confirm the organization, and provision a Sandbox service account.
--organization records your confirmed choice; --tenant overrides automatic Sandbox selection.
--force replaces saved credentials (does not delete the old service account)."; return ;;
      --organization|--tenant)
        [ $# -ge 2 ] && [ -n "$2" ] && [[ "$2" != --* ]] || fail "$1 needs a value"
        arg="$1"; shift
        SETUP_ARGS+=("$arg" "$1") ;;
      --force) SETUP_ARGS+=("$1") ;;
      *) fail "unknown option for setup: $1" ;;
    esac
    shift
  done
  [ "$ENVIRONMENT" = sandbox ] || fail "automatic setup is Sandbox only. Existing credentials belong in $CREDENTIALS."
  need_vgs_cli
  "$CLI_ENV/bin/python" "$KIT_DIR/tools/bootstrap/setup.py" --state-dir "$STATE_DIR" \
    --vgs "$CLI_ENV/bin/vgs" ${SETUP_ARGS[@]+"${SETUP_ARGS[@]}"}
  [ "${AWG_IN_START:-}" = 1 ] || say "Next: ./awg start"
}

# ---------------------------------------------------------------- session

session_alive() {  # session_alive <file>; with AWG_EGRESS set, the session must also go out through that proxy
  [ -f "$1" ] && jq -e '(.data.attributes.expires_at | fromdateiso8601) > (now + 60)' "$1" >/dev/null 2>&1 || return 1
  [ -z "${AWG_EGRESS:-}" ] || jq -e --arg name "$AWG_EGRESS" --slurpfile saved "$EGRESS_FILE" '
    ([$saved[0].profiles[]? | select((.name | ascii_downcase) == ($name | ascii_downcase))][0].proxy) as $proxy
    | (.data.attributes.egress_proxy_settings // {}) as $own
    | $proxy != null and $own.hostname == $proxy.hostname and $own.port == $proxy.port' "$1" >/dev/null 2>&1
}

latest_session() { [ -f "$LATEST" ] && cat "$LATEST" || true; }

# Scopes carried by an access token, space-separated; empty if the token cannot be read.
token_scopes() {  # token_scopes <token>
  printf '%s' "$1" | jq -rR '(split(".")[1] | gsub("-";"+") | gsub("_";"/")) as $p
    | ($p + ("==="[0:((4 - ($p | length) % 4) % 4)])) | @base64d | fromjson
    | if "'"${2:-scope}"'" == "roles" then ((.resource_access // {}) | [.[].roles[]?] | join(" ")) else (.scope // "") end' 2>/dev/null || true
}

# The APIs read the token's scope claim. An account can hold a scope as a role and still get a token without it.
SCOPES_HELD=""; SCOPES_GRANTED=""; CARD_ERROR=""; ALIAS_ERROR=""
read_token_scopes() {  # read_token_scopes <token>
  SCOPES_HELD=" $(token_scopes "$1") "
  SCOPES_GRANTED=" $(token_scopes "$1" roles) "
  [ -n "${SCOPES_HELD// /}" ] || SCOPES_HELD="$SCOPES_GRANTED"
  [[ "$SCOPES_HELD" != *" cards:write "* ]] || SCOPES_HELD="$SCOPES_HELD cards:create cards:update "
  [[ "$SCOPES_GRANTED" != *" cards:write "* ]] || SCOPES_GRANTED="$SCOPES_GRANTED cards:create cards:update "
}

# The account may not have been created by this kit. Say what it lacks before any call is refused.
report_account_scopes() {  # report_account_scopes <token>
  local scope missing="" unissued=""
  read_token_scopes "$1"
  [ -n "${SCOPES_HELD// /}" ] || return 0
  for scope in cards:create cards:read cards:update aliases:write reveal-sessions:read reveal-sessions:write agent-gateway:read agent-gateway:write; do
    [[ "$SCOPES_HELD" != *" $scope "* ]] || continue
    if [[ "$SCOPES_GRANTED" = *" $scope "* ]]; then unissued="$unissued${unissued:+, }$scope"
    else missing="$missing${missing:+, }$scope"; fi
  done
  if [ -n "$missing" ]; then
    say "Note: this service account lacks: $missing."
    say "      The kit works with what the account has. If a step below is refused, that is the reason;"
    say "      './awg setup --force' creates an account with every scope the kit uses."
  fi
  if [ -n "$unissued" ]; then
    say "Note: this service account was granted $unissued, but VGS leaves them out of its access token."
    say "      The kit works with what the token has. A new account is likely to get the same token,"
    say "      so this needs VGS: report it with your organization and tenant IDs."
  fi
}

# Why the Cards API refused, in terms the developer can act on.
explain_card_refusal() {  # explain_card_refusal <token>
  [[ "$CARD_ERROR" = "HTTP 403"* ]] || return 0
  read_token_scopes "$1"
  [ -n "${SCOPES_HELD// /}" ] || return 0
  if [[ "$SCOPES_HELD" = *" cards:create "* ]]; then
    say "  This service account has the card scope, so the Cards API itself is not enabled for tenant $2. Only VGS can enable it."
  elif [[ "$SCOPES_GRANTED" = *" cards:create "* ]]; then
    say "  This service account was granted cards:create, but its access token does not carry it. Only VGS can fix that; a new account is unlikely to help."
  else
    say "  This service account was created without cards:create. Scopes cannot be added later; './awg setup --force' makes a new account."
  fi
}

# Same test card through the vault alias API (aliases:write), for tenants where the Cards API refuses.
store_test_aliases() {  # store_test_aliases <token> <tenant>
  local response code
  response=$(mktemp "$STATE_DIR/card.XXXXXX")
  code=$(curl -sS -o "$response" -w '%{http_code}' -X POST "https://$2.sandbox.vault-api.verygoodvault.$DOMAIN/aliases" \
    -H "Authorization: Bearer $1" -H 'Content-Type: application/json' \
    -d '{"data":[{"value":"4111111111111111","format":"UUID","storage":"PERSISTENT"},{"value":"123","format":"UUID","storage":"VOLATILE"}]}') || code=000
  if [ "$code" = 201 ] && jq -e '.data | length == 2' "$response" >/dev/null 2>&1; then
    jq '[.data[] | (.aliases | map(select(.format == "UUID")) | .[0].alias)] as $a
        | {pan_alias: $a[0], cvc_alias: $a[1], bin: "411111", length: 16, fresh: true}' "$response" > "$CARD_FILE"
    rm -f "$response"
    jq -e '.pan_alias and .cvc_alias' "$CARD_FILE" >/dev/null 2>&1 && return 0
    rm -f "$CARD_FILE"
    ALIAS_ERROR="HTTP 201 without aliases"
    return 1
  fi
  ALIAS_ERROR="HTTP $code $(jq -c '[.errors[]? | {code, title, detail}] // .' "$response" 2>/dev/null | cut -c1-400)"
  rm -f "$response"
  return 1
}

# Stores the standard VGS test card so the session has fresh aliases. Never a real card.
store_test_card() {  # store_test_card <token>
  local response code year
  response=$(mktemp "$STATE_DIR/card.XXXXXX")
  year=$(( ($(date +%Y) + 3) % 100 ))   # the cards API takes a two-digit year
  code=$(curl -sS -o "$response" -w '%{http_code}' -X POST "$API/cards" \
    -H "Authorization: Bearer $1" -H 'Content-Type: application/vnd.api+json' -H 'Accept: application/vnd.api+json' \
    -d "$(jq -n --argjson y "$year" '{data:{attributes:{pan:"4111111111111111",cvc:"123",exp_month:12,exp_year:$y}}}')") || code=000
  if { [ "$code" = 201 ] || [ "$code" = 303 ]; } && jq -e '.data.attributes.pan_alias' "$response" >/dev/null 2>&1; then
    jq '.data | {card_id: .id, pan_alias: .attributes.pan_alias, cvc_alias: .attributes.cvc_alias,
                 bin: (.attributes.bin // "411111"), length: 16, fresh: true}' "$response" > "$CARD_FILE"
    rm -f "$response"
    return 0
  fi
  CARD_ERROR="HTTP $code $(jq -c '[.errors[]? | {code, title, detail}] // .' "$response" 2>/dev/null | cut -c1-400)"
  rm -f "$response"
  return 1
}

cmd_session() {
  local hosts="${1:-}" token tenant request response code id file
  for tool in curl jq; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_credentials
  mkdir -p "$SESSIONS_DIR"
  # AWG_EGRESS names a proxy saved in the Control Panel. VGS sends the session's traffic out through it.
  if [ -n "${AWG_EGRESS:-}" ]; then
    [ -f "$EGRESS_FILE" ] || fail "AWG_EGRESS is set, but no proxy has been saved yet. Save one in the Control Panel under Egress proxy settings."
    jq -e --arg name "$AWG_EGRESS" 'any(.profiles[]?; (.name | ascii_downcase) == ($name | ascii_downcase))' "$EGRESS_FILE" >/dev/null 2>&1 \
      || fail "no saved proxy is named \"$AWG_EGRESS\". Saved: $(jq -r '[.profiles[]?.name] | join(", ")' "$EGRESS_FILE" 2>/dev/null)"
  fi
  tenant=$(cred VGS_TENANT)
  token=$(access_token)
  report_account_scopes "$token"

  # AWG_CARD_STORE=aliases skips the Cards API, for tenants without it.
  if [ "${AWG_CARD_STORE:-}" != aliases ] && store_test_card "$token"; then
    say "Stored the VGS test card (4111 … 1111) and got fresh aliases."
  elif store_test_aliases "$token" "$tenant"; then
    say "Stored the test card (4111 … 1111) through the alias API. The session has the number and the CVC; this is not an error and nothing else is needed."
    if [ -n "${CARD_ERROR:-}" ]; then
      say "  For reference, the Cards API was not used because it answered $CARD_ERROR."
      explain_card_refusal "$token" "$tenant"
    fi
  elif [ -f "$CARD_FILE" ]; then
    jq '.fresh = false' "$CARD_FILE" > "$CARD_FILE.tmp" && mv "$CARD_FILE.tmp" "$CARD_FILE"
    say "Could not store the test card just now (Cards API: $CARD_ERROR; alias API: $ALIAS_ERROR)."
    explain_card_refusal "$token" "$tenant"
    say "Using the card number alias saved earlier (no CVC)."
  else
    say "Cards API answered: $CARD_ERROR"
    say "Alias API answered: $ALIAS_ERROR"
    explain_card_refusal "$token" "$tenant"
    fail "could not store a test card with either API.
       Or save your own aliases as $CARD_FILE:
       {\"pan_alias\": \"tok_sandbox_…\", \"bin\": \"411111\", \"length\": 16}"
  fi

  # The request can hold the egress proxy's password, so it goes to curl as a private file.
  request=$(mktemp "$SESSIONS_DIR/new.XXXXXX")
  jq -n --arg hosts "$hosts" --slurpfile c "$CARD_FILE" --arg egress "${AWG_EGRESS:-}" \
    --slurpfile saved "$([ -n "${AWG_EGRESS:-}" ] && printf '%s' "$EGRESS_FILE" || printf /dev/null)" '
    ($c[0]) as $card
    | ([$saved[0].profiles[]? | select((.name | ascii_downcase) == ($egress | ascii_downcase))][0].proxy) as $proxy
    | {label: "main", number: {alias: $card.pan_alias, bin: $card.bin, length: $card.length}}
      + (if $card.fresh == true and $card.cvc_alias then {cvc: {alias: $card.cvc_alias, length: 3, storage: "VOLATILE"}} else {} end) as $entry
    | {data: {type: "reveal-sessions", attributes:
        ({cards: [$entry]} + (if $hosts == "" then {} else {allowed_hosts: ($hosts | split(","))} end)
         + (if $proxy then {egress_proxy_settings: $proxy} else {} end))}}' > "$request"
  response=$(mktemp "$SESSIONS_DIR/new.XXXXXX")
  code=$(curl -sS -o "$response" -w '%{http_code}' "$API/reveal-sessions" \
    -H "Authorization: Bearer $token" -H "VGS-Tenant: $tenant" \
    -H 'Content-Type: application/vnd.api+json' --data-binary "@$request") || code=000
  if [ "$code" != 201 ]; then
    say "VGS answered HTTP $code:"
    jq -c '.errors // .' "$response" 2>/dev/null | cut -c1-500 || true
    rm -f "$response" "$request"
    [ "$code" != 403 ] || say "A 403 here means the service account lacks reveal-sessions:write, or Agent Web Gateway is not enabled for tenant $tenant."
    fail "the session was not created."
  fi
  id=$(jq -r .data.id "$response")
  file="$SESSIONS_DIR/$id.json"
  mv "$response" "$file"
  # The Control Panel reads the egress proxy's credentials for this session from its saved request.
  if [ -n "${AWG_EGRESS:-}" ]; then mv "$request" "$SESSIONS_DIR/$id.request.json"; else rm -f "$request"; fi
  printf '%s' "$file" > "$LATEST"
  jq '{id: .data.id, expires_at: .data.attributes.expires_at, allowed_hosts: (.data.attributes.allowed_hosts // []),
       unlisted_host_mode: .data.attributes.unlisted_host_mode}
      + ((.data.attributes.egress_proxy_settings // {}) | if .hostname then {egress_proxy: "\(.hostname):\(.port)"} else {} end)' "$file"
  say "Session saved to $file"
}

# ---------------------------------------------------------------- panel / browser

cmd_panel() {
  [ -f "$PANEL_DIR/start-proxy-controls.py" ] || fail "control panel not found in $PANEL_DIR"
  kit_python "$PANEL_DIR/start-proxy-controls.py" --environment "$ENVIRONMENT" "$@"
}

cmd_browser() {
  have openssl || fail "openssl is required to trust the session's certificate. Install it with your package manager."
  cloak_python python "$KIT_DIR/tools/cloak/launch-panel.py" --profile "$PROFILE_DIR" "$@"
}

cmd_cloak_login() {
  say "CloakBrowser needs a license key. The free tier allows one browser at a time."
  say "Get a key at https://github.com/CloakHQ/CloakBrowser, then paste it below."
  cloak_python cloakbrowser login
}

# A browser left open by an earlier ./awg start still holds the profile, so a second one cannot start.
close_earlier_browser() {
  local lock pid answer=""
  lock=$(readlink "$PROFILE_DIR/SingletonLock" 2>/dev/null) || return 0
  pid=${lock##*-}
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  kill -0 "$pid" 2>/dev/null || return 0
  ps -p "$pid" -o command= 2>/dev/null | grep -qF -- "--user-data-dir=$PROFILE_DIR" || return 0
  say "CloakBrowser from an earlier ./awg start is still open. Only one can run at a time."
  [ -t 0 ] || fail "close that browser window, then run ./awg start again."
  read -r -p "Close it and continue? [Y/n] " answer
  case "$answer" in
    ""|y|Y|yes|Yes) ;;
    *) fail "left it open. Close that browser window, then run ./awg start again." ;;
  esac
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.5; done
  fail "that browser did not close. Quit it yourself, then run ./awg start again."
}

cmd_start() {
  local url="${1:-}" host="" session helper_pid extension
  for tool in curl jq openssl; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_uv
  ensure_credentials
  need_cloak_license
  close_earlier_browser
  [ -z "$url" ] || host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#[/:?].*$##')
  session=$(latest_session)
  if session_alive "$session" && { [ -z "$host" ] || jq -e --arg h "$host" '(.data.attributes.allowed_hosts // []) | index($h)' "$session" >/dev/null; }; then
    say "Using the current session: $(basename "$session" .json)"
  else
    say "Creating a reveal session${host:+ for $host}..."
    cmd_session "$host"
    session=$(latest_session)
  fi

  say ""
  say "Starting the control panel helper..."
  : > "$HELPER_LOG"
  # The browser profile keeps an extension's background worker for as long as the extension keeps
  # its identity, and that worker holds one start's helper address and session. An unpacked
  # extension's identity is its folder, so each start generates the panel into a new one.
  rm -rf "$STATE_DIR/panel-extension"
  extension="$STATE_DIR/panel-extension/$(date +%s)-$$"
  mkdir -p "$STATE_DIR/panel-extension"
  chmod 700 "$STATE_DIR/panel-extension"
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
    python "$PANEL_DIR/start-proxy-controls.py" --session "$session" --output "$extension" \
    --environment "$ENVIRONMENT" --credentials-file "$CREDENTIALS" --sessions-dir "$SESSIONS_DIR" --exit-with-pid "$$" > "$HELPER_LOG" 2>&1 &
  helper_pid=$!
  # Capture the PID now: EXIT runs after this function's locals leave scope. uv runs the helper as
  # a child, so stop that too; --exit-with-pid covers the case where this script is killed outright.
  trap "pkill -P '$helper_pid' 2>/dev/null || true; kill '$helper_pid' 2>/dev/null || true; wait '$helper_pid' 2>/dev/null || true; rm -rf '$STATE_DIR/panel-extension'" EXIT
  for _ in $(seq 1 60); do
    grep -q 'Proxy controls are ready' "$HELPER_LOG" 2>/dev/null && break
    kill -0 "$helper_pid" 2>/dev/null || { fail "the control panel helper stopped. Inspect the private log at $HELPER_LOG locally."; }
    sleep 0.5
  done
  grep -q 'Proxy controls are ready' "$HELPER_LOG" || { fail "the control panel helper did not become ready in 30 seconds. Inspect $HELPER_LOG locally."; }
  say "Helper is running. Opening CloakBrowser..."
  say ""
  # AWG_CDP_PORT also opens Chrome DevTools on that local port, for an agent framework (see ./awg browser-use).
  cmd_browser --profile "$PROFILE_DIR" --extension "$extension" --session "$session" \
    ${AWG_CDP_PORT:+--cdp-port "$AWG_CDP_PORT"} ${url:+"$url"}
}

# ---------------------------------------------------------------- Kernel cloud browser

KERNEL_API="${KERNEL_API_URL:-https://api.onkernel.com}"
KERNEL_CODE=""; KERNEL_BODY=""

kernel_call() {  # kernel_call <method> <path> [json body]; sets KERNEL_CODE and KERNEL_BODY (a private file)
  [ -n "$KERNEL_BODY" ] || KERNEL_BODY=$(mktemp "$STATE_DIR/kernel.XXXXXX")
  # The body carries the session's proxy password, so it goes over stdin, not the command line.
  KERNEL_CODE=$(printf '%s' "${3:-}" | curl -sS -o "$KERNEL_BODY" -w '%{http_code}' -X "$1" "$KERNEL_API$2" \
    -H "Authorization: Bearer $KERNEL_API_KEY" -H 'Content-Type: application/json' ${3:+--data-binary @-}) || KERNEL_CODE=000
}

# Each cloud browser provider's API key is asked for once and kept in a private file. The key in the
# environment still works, and is saved the same way so the next run needs nothing.
#   <provider> <variable> <slug> <where to create a key> <command that uses it>
save_provider_key() {  # save_provider_key <slug> <key>
  mkdir -p "$STATE_DIR"
  chmod 700 "$STATE_DIR"
  printf '%s\n' "$2" > "$STATE_DIR/$1-key.tmp"
  chmod 600 "$STATE_DIR/$1-key.tmp"
  mv "$STATE_DIR/$1-key.tmp" "$STATE_DIR/$1-key"
}

provider_login() {
  local key=""
  [ -t 0 ] || fail "run './awg $3-login' in your own terminal to save the $1 API key."
  say "Create an API key in your $1 account ($4), then paste it below. It is saved privately and not shown."
  read -r -s -p "$1 API key: " key
  say ""
  key=$(printf '%s' "$key" | tr -d '[:space:]')
  [ -n "$key" ] || fail "no key entered."
  save_provider_key "$3" "$key"
  printf -v "$2" '%s' "$key"
  say "Saved. ./awg $5 will use it from now on."
}

need_provider_key() {
  local file="$STATE_DIR/$3-key" key="${!2:-}"
  if [ -n "$key" ]; then
    [ "$(tr -d '[:space:]' < "$file" 2>/dev/null || true)" = "$key" ] || save_provider_key "$3" "$key"
    return
  fi
  if [ -s "$file" ]; then
    chmod 600 "$file" 2>/dev/null || true
    printf -v "$2" '%s' "$(tr -d '[:space:]' < "$file")"
    [ -z "${!2}" ] || return 0
  fi
  [ -t 0 ] || fail "$2 is not set and no $1 API key is saved. Run './awg $3-login' in your own terminal once."
  provider_login "$@"
}

KERNEL_KEY=(Kernel KERNEL_API_KEY kernel https://kernel.sh kernel)
BROWSER_USE_KEY=("Browser Use Cloud" BROWSER_USE_API_KEY browser-use https://cloud.browser-use.com "browser-use --cloud")
BROWSERBASE_KEY=(Browserbase BROWSERBASE_API_KEY browserbase https://www.browserbase.com/settings browserbase)

need_kernel_key() {
  # Kernel's CLI, which opens the tunnel to the local helper, reads the key from the environment.
  export KERNEL_API_KEY="${KERNEL_API_KEY:-}"
  need_provider_key "${KERNEL_KEY[@]}"
}

KERNEL_BROWSER=""; KERNEL_PROXY=""; KERNEL_EXTENSION=""; KERNEL_ZIP=""
KERNEL_HELPER=""; KERNEL_TUNNEL=""; KERNEL_PANEL_DIR=""

# The full panel needs Kernel's CLI (for its SSH tunnel) and websocat. Install them once when Homebrew is present.
kernel_tunnel_tools() {
  [ "${AWG_KERNEL_TUNNEL:-1}" != 0 ] || return 1
  have ssh || return 1
  if ! have kernel || ! have websocat; then
    have brew || { say "For the full Control Panel, install Kernel's CLI and websocat (https://www.kernel.sh/docs/browsers/ssh)."; return 1; }
    say "Installing Kernel's CLI and websocat for the tunnel to the local helper..."
    have kernel || brew install kernel/tap/kernel >/dev/null 2>&1 || true
    have websocat || brew install websocat >/dev/null 2>&1 || true
  fi
  have kernel && have websocat && return 0
  say "Kernel's CLI and websocat could not be installed. Loading the panel without the local helper."
  return 1
}

kernel_cleanup() {
  if [ -n "$KERNEL_TUNNEL" ]; then pkill -P "$KERNEL_TUNNEL" 2>/dev/null || true; kill "$KERNEL_TUNNEL" 2>/dev/null || true; fi
  if [ -n "$KERNEL_HELPER" ]; then pkill -P "$KERNEL_HELPER" 2>/dev/null || true; kill "$KERNEL_HELPER" 2>/dev/null || true; fi
  [ -z "$KERNEL_PANEL_DIR" ] || rm -rf "$STATE_DIR/panel-extension"
  rm -f "$STATE_DIR/kernel-tunnel.log"
  [ -z "$KERNEL_BROWSER" ] || kernel_call DELETE "/browsers/$KERNEL_BROWSER"
  [ -z "$KERNEL_EXTENSION" ] || kernel_call DELETE "/extensions/$KERNEL_EXTENSION"
  [ -z "$KERNEL_PROXY" ] || kernel_call DELETE "/proxies/$KERNEL_PROXY"
  [ -z "$KERNEL_BODY" ] || rm -f "$KERNEL_BODY"
  [ -z "$KERNEL_ZIP" ] || rm -f "$KERNEL_ZIP"
}

kernel_refused() {  # kernel_refused <what was attempted>
  say "Kernel answered HTTP $KERNEL_CODE:"
  jq -c '{code, message} | with_entries(select(.value != null))' "$KERNEL_BODY" 2>/dev/null | cut -c1-400 || true
  [ "$KERNEL_CODE" != 401 ] || say "Kernel did not accept the API key. Check it in your Kernel account, then save a new one with:  ./awg kernel-login"
  fail "$1"
}

# Kernel (kernel.sh) runs the browser in its cloud. The reveal session's proxy and certificate are
# registered there as a custom proxy, so the browser's traffic passes through the same session.
cmd_kernel() {
  local url="${1:-}" host="" session body proxy_id browser_id live extension_id="" helper_port=""
  for tool in curl jq; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_kernel_key
  need_uv
  ensure_credentials
  [ -z "$url" ] || host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#[/:?].*$##')
  session=$(latest_session)
  if session_alive "$session" && { [ -z "$host" ] || jq -e --arg h "$host" '(.data.attributes.allowed_hosts // []) | index($h)' "$session" >/dev/null; }; then
    say "Using the current session: $(basename "$session" .json)"
  else
    say "Creating a reveal session${host:+ for $host}..."
    cmd_session "$host"
    session=$(latest_session)
  fi

  body=$(jq --arg name "awg-$(basename "$session" .json)-$(date +%s)" '
    def unpct: gsub("%(?<h>[0-9A-Fa-f]{2})"; (.h | ascii_downcase | explode
      | map(if . > 96 then . - 87 else . - 48 end) | [.[0] * 16 + .[1]] | implode));
    .data.attributes.proxy as $p
    | ($p.url | capture("^(?<scheme>https?)://(?<user>[^:@/]+):(?<pass>[^@/]+)@(?<host>[^:/@]+):(?<port>[0-9]+)")) as $u
    | {type: "custom", name: $name, protocol: $u.scheme,
       config: {host: $u.host, port: ($u.port | tonumber), username: ($u.user | unpct),
                password: ($u.pass | unpct), ca_bundle: $p.ca_bundle}}' "$session" 2>/dev/null) \
    || fail "the saved session has no usable proxy details. Create a new one with ./awg session"

  say ""
  say "Registering the session with Kernel as a custom proxy..."
  # The proxy entry and the panel hold this session's credentials, so everything is removed on the way out.
  trap kernel_cleanup EXIT
  kernel_call POST /proxies "$body"
  [ "$KERNEL_CODE" = 201 ] || [ "$KERNEL_CODE" = 200 ] || kernel_refused "Kernel did not create the proxy."
  proxy_id=$(jq -r '.id // empty' "$KERNEL_BODY")
  [ -n "$proxy_id" ] || fail "Kernel returned no proxy id."
  KERNEL_PROXY="$proxy_id"

  # The full Control Panel needs its helper, which holds the service-account credentials and stays on
  # this machine. Kernel's SSH tunnel lets the cloud browser reach it, so nothing secret is uploaded.
  KERNEL_ZIP="$STATE_DIR/kernel-panel.$$.zip"
  if kernel_tunnel_tools; then
    say "Starting the control panel helper on this machine..."
    : > "$HELPER_LOG"
    rm -rf "$STATE_DIR/panel-extension"
    KERNEL_PANEL_DIR="$STATE_DIR/panel-extension/$(date +%s)-$$"
    mkdir -p "$STATE_DIR/panel-extension"
    chmod 700 "$STATE_DIR/panel-extension"
    PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
      python "$PANEL_DIR/start-proxy-controls.py" --session "$session" --output "$KERNEL_PANEL_DIR" \
      --environment "$ENVIRONMENT" --credentials-file "$CREDENTIALS" --sessions-dir "$SESSIONS_DIR" --exit-with-pid "$$" > "$HELPER_LOG" 2>&1 &
    KERNEL_HELPER=$!
    for _ in $(seq 1 60); do
      grep -q 'Proxy controls are ready' "$HELPER_LOG" 2>/dev/null && break
      kill -0 "$KERNEL_HELPER" 2>/dev/null || break
      sleep 0.5
    done
    helper_port=$(grep -o 'http://127\.0\.0\.1:[0-9]*' "$KERNEL_PANEL_DIR/background.js" 2>/dev/null | head -1 | sed 's/.*://')
    if [ -z "$helper_port" ]; then
      say "The local helper did not start (see $HELPER_LOG). Loading the panel without it."
    fi
  fi

  say "Uploading the Control Panel to Kernel..."
  if { if [ -n "$helper_port" ]; then
         kit_python "$KIT_DIR/tools/kernel/build-extension.py" --folder "$KERNEL_PANEL_DIR" --output "$KERNEL_ZIP"
       else
         kit_python "$KIT_DIR/tools/kernel/build-extension.py" --session "$session" \
           --environment "$ENVIRONMENT" --credentials-file "$CREDENTIALS" --output "$KERNEL_ZIP"
       fi; } && [ -s "$KERNEL_ZIP" ]; then
    KERNEL_CODE=$(curl -sS -o "$KERNEL_BODY" -w '%{http_code}' -X POST "$KERNEL_API/extensions" \
      -H "Authorization: Bearer $KERNEL_API_KEY" -F "file=@$KERNEL_ZIP;type=application/zip" \
      -F "name=awg-panel-$(date +%s)-$$") || KERNEL_CODE=000
    if [ "$KERNEL_CODE" = 201 ] || [ "$KERNEL_CODE" = 200 ]; then
      extension_id=$(jq -r '.id // empty' "$KERNEL_BODY")
      KERNEL_EXTENSION="$extension_id"
    else
      say "Kernel did not accept the Control Panel (HTTP $KERNEL_CODE $(jq -r '.code // empty' "$KERNEL_BODY" 2>/dev/null)). Continuing without it."
    fi
  else
    say "Could not build the Control Panel for Kernel. Continuing without it."
  fi

  say "Starting a Kernel browser..."
  kernel_call POST /browsers "$(jq -n --arg id "$proxy_id" --arg url "$url" --arg ext "$extension_id" \
    '{proxy: {id: $id}, timeout_seconds: 1800}
     + (if $url == "" then {} else {start_url: $url} end)
     + (if $ext == "" then {} else {extensions: [{id: $ext}]} end)')"
  [ "$KERNEL_CODE" = 201 ] || [ "$KERNEL_CODE" = 200 ] || kernel_refused "Kernel did not start the browser."
  browser_id=$(jq -r '.session_id // empty' "$KERNEL_BODY")
  live=$(jq -r '.browser_live_view_url // empty' "$KERNEL_BODY")
  [ -n "$browser_id" ] || fail "Kernel returned no browser session id."
  KERNEL_BROWSER="$browser_id"

  say ""
  say "A Kernel browser is running through session $(basename "$session" .json)."
  # Kernel's own identifiers, for Kernel support.
  say "Kernel browser session: $browser_id"
  say "Kernel proxy: $proxy_id"
  if [ -n "$extension_id" ] && [ -n "$helper_port" ]; then
    # Reverse tunnel: 127.0.0.1:<port> inside the browser's VM reaches the helper on this machine.
    say "Connecting the Kernel browser to the local helper..."
    ( exec kernel browsers ssh "$browser_id" -R "$helper_port:localhost:$helper_port" < <(exec sleep 86400) ) \
      > "$STATE_DIR/kernel-tunnel.log" 2>&1 &
    KERNEL_TUNNEL=$!
    for _ in $(seq 1 "${AWG_KERNEL_TUNNEL_WAIT:-20}"); do kill -0 "$KERNEL_TUNNEL" 2>/dev/null || break; sleep 1; done
    if kill -0 "$KERNEL_TUNNEL" 2>/dev/null; then
      say "Control Panel: full, connected to the helper on this machine through Kernel's SSH tunnel."
    else
      KERNEL_TUNNEL=""
      say "The tunnel to the local helper did not stay open (see $STATE_DIR/kernel-tunnel.log)."
      say "The panel will show 'Helper unavailable'; session details and route switching still work."
    fi
  elif [ -n "$extension_id" ]; then
    say "Control Panel: session details and route switching only. Install Kernel's CLI and websocat for the full panel."
  fi
  if [ -n "$extension_id" ]; then
    # Kernel runs this inside the browser's VM: find the panel among the loaded extensions and open it in a tab.
    kernel_call POST "/browsers/$browser_id/playwright/execute" "$(jq -n '{timeout_sec: 45, code: "
      let id = null;
      for (let attempt = 0; attempt < 40 && !id; attempt++) {
        for (const worker of context.serviceWorkers()) {
          if (!worker.url().startsWith(\"chrome-extension://\")) continue;
          try {
            const name = await worker.evaluate(() => chrome.runtime.getManifest().name);
            if (name === \"Agent Web Gateway Control Panel\") id = worker.url().split(\"/\")[2];
          } catch (error) {}
        }
        if (!id) await new Promise(resolve => setTimeout(resolve, 500));
      }
      if (!id) return \"not found\";
      const panel = await context.newPage();
      await panel.goto(\"chrome-extension://\" + id + \"/popup.html\");
      await panel.bringToFront();
      return id;"}')"
    if [ "$KERNEL_CODE" = 200 ] && jq -e '.success == true and (.result | type) == "string" and .result != "not found"' "$KERNEL_BODY" >/dev/null 2>&1; then
      say "Control Panel: open in a tab of the Kernel browser."
    else
      say "Control Panel: loaded, but it could not be opened automatically. Open it from the browser's extensions menu (puzzle icon)."
    fi
  fi
  if [ -n "$live" ]; then
    say "Watch and control it here (keep this link private; it controls the browser):"
    say "  $live"
  else
    say "Kernel returned no live view link. Open the browser from your Kernel dashboard."
  fi
  say ""
  if [ -t 0 ]; then
    read -r -p "Press Enter to close the Kernel browser and remove what was registered. " _ || true
  else
    say "This command runs until the Kernel browser closes (30 minutes idle) or it is stopped."
    while kernel_call GET "/browsers/$browser_id"; [ "$KERNEL_CODE" = 200 ]; do sleep 30; done
  fi
  say "Closing the Kernel browser and removing what was registered..."
}

# ---------------------------------------------------------------- Browser Use cloud browser

BROWSER_USE_API="${BROWSER_USE_API_URL:-https://api.browser-use.com/api/v4}"
BU_CODE=""; BU_BODY=""; BU_BROWSER=""; BU_EXTENSION=""; BU_ZIP=""
BU_HELPER=""; BU_RELAY=""; BU_PANEL_DIR=""

bu_call() {  # bu_call <method> <path> [json body]; sets BU_CODE and fills BU_BODY (a private file)
  # The body carries the session's proxy password, so it goes over stdin, not the command line.
  BU_CODE=$(printf '%s' "${3:-}" | curl -sS -o "$BU_BODY" -w '%{http_code}' -X "$1" "$BROWSER_USE_API$2" \
    -H "X-Browser-Use-API-Key: $BROWSER_USE_API_KEY" -H 'Content-Type: application/json' ${3:+--data-binary @-}) || BU_CODE=000
}

bu_cleanup() {
  if [ -n "$BU_RELAY" ]; then pkill -P "$BU_RELAY" 2>/dev/null || true; kill "$BU_RELAY" 2>/dev/null || true; fi
  if [ -n "$BU_HELPER" ]; then pkill -P "$BU_HELPER" 2>/dev/null || true; kill "$BU_HELPER" 2>/dev/null || true; fi
  [ -z "$BU_PANEL_DIR" ] || rm -rf "$STATE_DIR/panel-extension"
  rm -f "$STATE_DIR/browser-use-relay.log"
  [ -z "$BU_BROWSER" ] || bu_call PATCH "/browsers/$BU_BROWSER" '{"action":"stop"}'
  [ -z "$BU_EXTENSION" ] || bu_call DELETE "/extensions/$BU_EXTENSION"
  [ -z "$BU_BODY" ] || rm -f "$BU_BODY"
  [ -z "$BU_ZIP" ] || rm -f "$BU_ZIP"
}

# Browser Use's reason for a refusal. A validation error can echo the request, so only its field names and messages are shown.
bu_reason() {
  jq -r 'if (.detail | type) == "string" then .detail
         elif (.detail | type) == "array" then [.detail[] | ((.loc // []) | map(tostring) | join(".")) + ": " + (.msg // "")] | join("; ")
         elif (.message | type) == "string" then .message else empty end' "$BU_BODY" 2>/dev/null | cut -c1-400 || true
}

# The browser to create: the reveal session as Browser Use's custom proxy, with the session's certificate authority.
bu_browser_body() {  # bu_browser_body <session file> <extension id or empty>
  jq --arg ext "$2" '
    def unpct: gsub("%(?<h>[0-9A-Fa-f]{2})"; (.h | ascii_downcase | explode
      | map(if . > 96 then . - 87 else . - 48 end) | [.[0] * 16 + .[1]] | implode));
    .data.attributes.proxy as $p
    | ($p.url | capture("^(?<scheme>https?)://(?<user>[^:@/]+):(?<pass>[^@/]+)@(?<host>[^:/@]+):(?<port>[0-9]+)")) as $u
    | {timeout: 30,
       customProxy: {host: $u.host, port: ($u.port | tonumber), protocol: $u.scheme,
                     username: ($u.user | unpct), password: ($u.pass | unpct), caBundle: $p.ca_bundle}}
      + (if $ext == "" then {} else {extensionIds: [$ext]} end)' "$1" 2>/dev/null
}

# Browser Use (github.com/browser-use/browser-use) drives a browser through its Chrome DevTools address.
# By default this is ./awg start with that address open: the local browser, on the session, with the full
# Control Panel. --cloud starts the browser in Browser Use Cloud instead.
cmd_browser_use() {
  if [ "${1:-}" = --cloud ]; then shift; cmd_browser_use_cloud "$@"; return; fi
  case "${1:-}" in
    --help|-h) say "Usage: ./awg browser-use [--cloud] [url]
Open the kit's browser on a reveal session with Chrome DevTools on 127.0.0.1:\${AWG_CDP_PORT:-9222},
for a Browser Use agent:  Browser(cdp_url='http://127.0.0.1:9222')
--cloud starts a Browser Use cloud browser on the session instead. The first run asks for your API key and saves it."; return ;;
    --*) fail "unknown option for browser-use: $1" ;;
  esac
  [[ "${AWG_CDP_PORT:=9222}" =~ ^[0-9]+$ ]] || fail "AWG_CDP_PORT must be a port number."
  cmd_start "$@"
}

# Browser Use Cloud runs the browser. The reveal session's proxy and certificate are passed as the
# browser's custom proxy, so the browser's traffic passes through the session.
cmd_browser_use_cloud() {
  local url="${1:-}" host="" session body browser_id live cdp extension_id="" runtime_id="" helper_port=""
  local -a tabs=()
  for tool in curl jq; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_provider_key "${BROWSER_USE_KEY[@]}"
  need_uv
  ensure_credentials
  [ -z "$url" ] || host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#[/:?].*$##')
  session=$(latest_session)
  if session_alive "$session" && { [ -z "$host" ] || jq -e --arg h "$host" '(.data.attributes.allowed_hosts // []) | index($h)' "$session" >/dev/null; }; then
    say "Using the current session: $(basename "$session" .json)"
  else
    say "Creating a reveal session${host:+ for $host}..."
    cmd_session "$host"
    session=$(latest_session)
  fi
  bu_browser_body "$session" "" >/dev/null || fail "the saved session has no usable proxy details. Create a new one with ./awg session"

  # The panel and Browser Use's answers hold this session's credentials, so everything is removed on the way out.
  trap bu_cleanup EXIT
  BU_BODY=$(mktemp "$STATE_DIR/browser-use.XXXXXX")
  BU_ZIP="$STATE_DIR/browser-use-panel.$$.zip"

  # The full Control Panel needs its helper, which holds the service-account credentials and stays on
  # this machine. Browser Use has no tunnel into its browsers, so the kit relays the panel's helper
  # requests over the browser's DevTools connection instead (tools/browser-use/helper-relay.py).
  say ""
  say "Starting the control panel helper on this machine..."
  : > "$HELPER_LOG"
  rm -rf "$STATE_DIR/panel-extension"
  BU_PANEL_DIR="$STATE_DIR/panel-extension/$(date +%s)-$$"
  mkdir -p "$STATE_DIR/panel-extension"
  chmod 700 "$STATE_DIR/panel-extension"
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
    python "$PANEL_DIR/start-proxy-controls.py" --session "$session" --output "$BU_PANEL_DIR" --managed-route \
    --environment "$ENVIRONMENT" --credentials-file "$CREDENTIALS" --sessions-dir "$SESSIONS_DIR" --exit-with-pid "$$" > "$HELPER_LOG" 2>&1 &
  BU_HELPER=$!
  for _ in $(seq 1 60); do
    grep -q 'Proxy controls are ready' "$HELPER_LOG" 2>/dev/null && break
    kill -0 "$BU_HELPER" 2>/dev/null || break
    sleep 0.5
  done
  helper_port=$(grep -o 'http://127\.0\.0\.1:[0-9]*' "$BU_PANEL_DIR/background.js" 2>/dev/null | head -1 | sed 's/.*://' || true)
  [ -n "$helper_port" ] || say "The local helper did not start (see $HELPER_LOG). Loading the panel without it."

  say "Uploading the Control Panel to Browser Use..."
  # Browser Use refuses extensions with the proxy permission, so the panel is built without it:
  # the browser's route stays on the session.
  if { if [ -n "$helper_port" ]; then
         kit_python "$KIT_DIR/tools/kernel/build-extension.py" --folder "$BU_PANEL_DIR" --output "$BU_ZIP"
       else
         kit_python "$KIT_DIR/tools/kernel/build-extension.py" --environment "$ENVIRONMENT" --session "$session" --credentials-file "$CREDENTIALS" \
           --managed-route --output "$BU_ZIP"
       fi; } && [ -s "$BU_ZIP" ]; then
    BU_CODE=$(curl -sS -o "$BU_BODY" -w '%{http_code}' -X POST "$BROWSER_USE_API/extensions" \
      -H "X-Browser-Use-API-Key: $BROWSER_USE_API_KEY" -F "file=@$BU_ZIP;type=application/zip") || BU_CODE=000
    if [ "$BU_CODE" = 201 ] || [ "$BU_CODE" = 200 ]; then
      extension_id=$(jq -r '.id // empty' "$BU_BODY")
      BU_EXTENSION="$extension_id"
    else
      say "Browser Use did not accept the Control Panel (HTTP $BU_CODE $(bu_reason)). Continuing without it."
    fi
  else
    say "Could not build the Control Panel for Browser Use. Continuing without it."
  fi

  say "Starting a Browser Use browser on the session's proxy..."
  bu_call POST /browsers "$(bu_browser_body "$session" "$extension_id")"
  if [ -n "$extension_id" ] && { [ "$BU_CODE" = 403 ] || [ "$BU_CODE" = 404 ] || [ "$BU_CODE" = 422 ]; }; then
    # Extensions can be unavailable to a project that has custom proxies. Try the browser on its own;
    # if that is refused too, the panel was not the reason and only the final answer is reported.
    extension_id=""
    bu_call POST /browsers "$(bu_browser_body "$session" "")"
    if [ "$BU_CODE" = 201 ] || [ "$BU_CODE" = 200 ]; then say "Browser Use would not load the Control Panel in this project. The browser started without it."; fi
  fi
  if [ "$BU_CODE" != 201 ] && [ "$BU_CODE" != 200 ]; then
    say "Browser Use answered HTTP $BU_CODE: $(bu_reason)"
    [ "$BU_CODE" != 401 ] || say "Browser Use did not accept the API key. Check it in your Browser Use Cloud account, then save a new one with:  ./awg browser-use-login"
    [ "$BU_CODE" != 403 ] || say "A 403 here usually means custom proxies are not enabled for this Browser Use project. They are an enterprise feature: ask Browser Use (sales@browser-use.com) to enable them."
    [ "$BU_CODE" != 402 ] || say "The Browser Use account is out of credits or over its spend limit."
    [ "$BU_CODE" != 429 ] || say "The Browser Use account has too many browsers running. Stop one and retry."
    fail "Browser Use did not start the browser."
  fi
  browser_id=$(jq -r '.id // empty' "$BU_BODY")
  live=$(jq -r '.liveUrl // empty' "$BU_BODY")
  cdp=$(jq -r '.cdpUrl // empty' "$BU_BODY")
  [ -n "$browser_id" ] || fail "Browser Use returned no browser id."
  BU_BROWSER="$browser_id"
  [ -z "$extension_id" ] || runtime_id=$(jq -r --arg id "$extension_id" '[.extensions[]? | select(.id == $id) | .runtimeId] | .[0] // empty' "$BU_BODY")

  say ""
  say "A Browser Use browser is running through session $(basename "$session" .json)."
  # Browser Use's own identifier, for Browser Use support.
  say "Browser Use browser: $browser_id"
  if [ -n "$runtime_id" ]; then
    if [ -n "$helper_port" ] && [ -n "$cdp" ]; then
      # Start the relay before the panel's tab opens, so its first helper request is answered.
      say "Connecting the Browser Use browser to the local helper..."
      printf '%s\n' "$cdp" | PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
        --with websockets==15.0.1 python "$KIT_DIR/tools/browser-use/helper-relay.py" "$helper_port" "$runtime_id" \
        > "$STATE_DIR/browser-use-relay.log" 2>&1 &
      BU_RELAY=$!
      sleep 2
      if kill -0 "$BU_RELAY" 2>/dev/null; then
        say "Control Panel: full, connected to the helper on this machine through the kit's relay. The route is fixed on the session's proxy."
      else
        say "The relay to the local helper did not stay open (see $STATE_DIR/browser-use-relay.log)."
        say "The panel will show 'Helper unavailable'; session details still work."
      fi
    else
      say "Control Panel: session details only. The route is fixed on the session's proxy."
    fi
  fi
  [ -z "$runtime_id" ] || tabs+=("chrome-extension://$runtime_id/popup.html")
  [ -z "$url" ] || tabs+=("$url")
  if [ ${#tabs[@]} -gt 0 ]; then
    # The DevTools address controls the browser, so it goes over stdin, not the command line.
    if [ -n "$cdp" ] && printf '%s\n' "$cdp" | PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
         --with websockets==15.0.1 python "$KIT_DIR/tools/browser-use/open-tabs.py" "${tabs[@]}"; then
      [ -z "$runtime_id" ] || say "Control Panel: open in a tab of the Browser Use browser."
    else
      [ -z "$runtime_id" ] || say "Control Panel: loaded, but it could not be opened automatically. Open chrome-extension://$runtime_id/popup.html in the browser."
      [ -z "$url" ] || say "Open $url in the browser yourself."
    fi
  fi
  [ -n "$runtime_id" ] || say "Control Panel: not loaded in this browser. Read the session's stand-ins from the session file instead."
  if [ -n "$live" ]; then
    say "Watch and control it here (keep this link private; it controls the browser):"
    say "  $live"
  else
    say "Browser Use returned no live view link. Open the browser from your Browser Use dashboard."
  fi
  if [ -n "$cdp" ]; then
    say "Connect your agent or Playwright to it here (Chrome DevTools address; keep it private, it also controls the browser):"
    say "  $cdp"
  fi
  say ""
  if [ -t 0 ]; then
    read -r -p "Press Enter to close the Browser Use browser and remove what was uploaded. " _ || true
  else
    say "This command runs until the Browser Use browser closes (after 30 minutes) or it is stopped."
    while bu_call GET "/browsers/$browser_id"; [ "$BU_CODE" = 200 ] && jq -e '.status == "active"' "$BU_BODY" >/dev/null 2>&1; do sleep 30; done
  fi
  say "Closing the Browser Use browser and removing what was uploaded..."
}

# ---------------------------------------------------------------- Browserbase cloud browser

BROWSERBASE_API="${BROWSERBASE_API_URL:-https://api.browserbase.com/v1}"
BB_CODE=""; BB_BODY=""; BB_BROWSER=""; BB_CERTIFICATE=""; BB_EXTENSION=""; BB_ZIP=""; BB_CA=""
BB_HELPER=""; BB_RELAY=""; BB_PANEL_DIR=""

bb_call() {  # bb_call <method> <path> [json body]; sets BB_CODE and fills BB_BODY (a private file)
  # The body carries the session's proxy password, so it goes over stdin, not the command line.
  BB_CODE=$(printf '%s' "${3:-}" | curl -sS -o "$BB_BODY" -w '%{http_code}' -X "$1" "$BROWSERBASE_API$2" \
    -H "X-BB-API-Key: $BROWSERBASE_API_KEY" -H 'Content-Type: application/json' ${3:+--data-binary @-}) || BB_CODE=000
}

bb_upload() {  # bb_upload <path> <file> <content type>; sets BB_CODE and fills BB_BODY
  BB_CODE=$(curl -sS -o "$BB_BODY" -w '%{http_code}' -X POST "$BROWSERBASE_API$1" \
    -H "X-BB-API-Key: $BROWSERBASE_API_KEY" -F "file=@$2;type=$3") || BB_CODE=000
}

bb_ok() { [ "$BB_CODE" = 200 ] || [ "$BB_CODE" = 201 ]; }

# Browserbase's reason for a refusal: its message only, never the echoed request.
bb_reason() { jq -r '(.message // .error // empty) | tostring' "$BB_BODY" 2>/dev/null | cut -c1-400 || true; }

bb_cleanup() {
  if [ -n "$BB_RELAY" ]; then pkill -P "$BB_RELAY" 2>/dev/null || true; kill "$BB_RELAY" 2>/dev/null || true; fi
  if [ -n "$BB_HELPER" ]; then pkill -P "$BB_HELPER" 2>/dev/null || true; kill "$BB_HELPER" 2>/dev/null || true; fi
  [ -z "$BB_PANEL_DIR" ] || rm -rf "$STATE_DIR/panel-extension"
  rm -f "$STATE_DIR/browserbase-relay.log"
  [ -z "$BB_BROWSER" ] || bb_call POST "/sessions/$BB_BROWSER" '{"status":"REQUEST_RELEASE"}'
  [ -z "$BB_EXTENSION" ] || bb_call DELETE "/extensions/$BB_EXTENSION"
  [ -z "$BB_CERTIFICATE" ] || bb_call DELETE "/certificates/$BB_CERTIFICATE"
  [ -z "$BB_BODY" ] || rm -f "$BB_BODY"
  [ -z "$BB_ZIP" ] || rm -f "$BB_ZIP"
  [ -z "$BB_CA" ] || rm -f "$BB_CA"
}

# The browser to create: the reveal session as Browserbase's external proxy, trusting the session's certificate authority.
bb_browser_body() {  # bb_browser_body <session file> <certificate id> <extension id or empty>
  jq --arg cert "$2" --arg ext "$3" --arg project "${BROWSERBASE_PROJECT_ID:-}" '
    def unpct: gsub("%(?<h>[0-9A-Fa-f]{2})"; (.h | ascii_downcase | explode
      | map(if . > 96 then . - 87 else . - 48 end) | [.[0] * 16 + .[1]] | implode));
    .data.attributes.proxy as $p
    | ($p.url | capture("^(?<scheme>https?)://(?<user>[^:@/]+):(?<pass>[^@/]+)@(?<host>[^:/@]+):(?<port>[0-9]+)")) as $u
    | {timeout: 1800, keepAlive: true,
       proxies: [{type: "external", server: ($u.scheme + "://" + $u.host + ":" + $u.port),
                  username: ($u.user | unpct), password: ($u.pass | unpct)}],
       proxySettings: {caCertificates: [$cert]}}
      + (if $project == "" then {} else {projectId: $project} end)
      + (if $ext == "" then {} else {extensionId: $ext} end)' "$1" 2>/dev/null
}

# Registers the session with Browserbase and starts a browser on it. Sets BB_CERTIFICATE and BB_BROWSER,
# and leaves Browserbase's answer in BB_BODY. Returns 1 with the reason printed when Browserbase refuses.
bb_start_browser() {  # bb_start_browser <session file> <extension id or empty>
  BB_CA="$STATE_DIR/browserbase-ca.$$.pem"
  jq -er '.data.attributes.proxy.ca_bundle' "$1" > "$BB_CA" 2>/dev/null || { say "The saved session has no certificate authority."; return 1; }
  bb_upload /certificates "$BB_CA" application/x-pem-file
  if ! bb_ok; then
    say "Browserbase answered HTTP $BB_CODE: $(bb_reason)"
    [ "$BB_CODE" != 401 ] || say "Browserbase did not accept the API key. Check it in your Browserbase project settings, then save a new one with:  ./awg browserbase-login"
    say "Browserbase did not store the session's certificate authority."
    return 1
  fi
  BB_CERTIFICATE=$(jq -r '.id // empty' "$BB_BODY")
  [ -n "$BB_CERTIFICATE" ] || { say "Browserbase returned no certificate id."; return 1; }
  bb_call POST /sessions "$(bb_browser_body "$1" "$BB_CERTIFICATE" "$2")"
  if ! bb_ok; then
    say "Browserbase answered HTTP $BB_CODE: $(bb_reason)"
    [ "$BB_CODE" != 401 ] || say "Browserbase did not accept the API key. Check it in your Browserbase project settings, then save a new one with:  ./awg browserbase-login"
    if [ "$BB_CODE" = 402 ] || [ "$BB_CODE" = 403 ]; then say "Custom proxies and keep-alive browsers need Browserbase's Developer plan or higher."; fi
    [ "$BB_CODE" != 429 ] || say "The Browserbase project has too many browsers running. Stop one and retry."
    say "Browserbase did not start the browser."
    return 1
  fi
  BB_BROWSER=$(jq -r '.id // empty' "$BB_BODY")
  [ -n "$BB_BROWSER" ] || { say "Browserbase returned no browser session id."; return 1; }
}

# Browserbase (browserbase.com) runs the browser in its cloud. The reveal session's proxy is passed as
# the browser's external proxy and its certificate authority is uploaded, so the browser's traffic
# passes through the session.
cmd_browserbase() {
  local url="${1:-}" host="" session browser_id live="" site="" cdp extension_id="" runtime_id="" helper_port=""
  local -a tabs=()
  case "$url" in
    --help|-h) say "Usage: ./awg browserbase [url]
Start a Browserbase cloud browser on a reveal session, with the Control Panel open in a tab.
The first run asks for your Browserbase API key and saves it. BROWSERBASE_PROJECT_ID is optional: Browserbase reads the project from the key."; return ;;
    --*) fail "unknown option for browserbase: $url" ;;
  esac
  for tool in curl jq; do have "$tool" || fail "$tool is required. Install it with your package manager (macOS: brew install $tool)."; done
  need_provider_key "${BROWSERBASE_KEY[@]}"
  need_uv
  ensure_credentials
  [ -z "$url" ] || host=$(printf '%s' "$url" | sed -E 's#^[a-z]+://##; s#[/:?].*$##')
  session=$(latest_session)
  if session_alive "$session" && { [ -z "$host" ] || jq -e --arg h "$host" '(.data.attributes.allowed_hosts // []) | index($h)' "$session" >/dev/null; }; then
    say "Using the current session: $(basename "$session" .json)"
  else
    say "Creating a reveal session${host:+ for $host}..."
    cmd_session "$host"
    session=$(latest_session)
  fi
  bb_browser_body "$session" "" "" >/dev/null || fail "the saved session has no usable proxy details. Create a new one with ./awg session"

  # The panel and Browserbase's answers hold this session's credentials, so everything is removed on the way out.
  trap bb_cleanup EXIT
  BB_BODY=$(mktemp "$STATE_DIR/browserbase.XXXXXX")
  BB_ZIP="$STATE_DIR/browserbase-panel.$$.zip"

  # The full Control Panel needs its helper, which holds the service-account credentials and stays on
  # this machine. As with Browser Use, the kit relays the panel's helper requests over the browser's
  # DevTools connection (tools/browser-use/helper-relay.py), and Browserbase sets the browser's route.
  say ""
  say "Starting the control panel helper on this machine..."
  : > "$HELPER_LOG"
  rm -rf "$STATE_DIR/panel-extension"
  BB_PANEL_DIR="$STATE_DIR/panel-extension/$(date +%s)-$$"
  mkdir -p "$STATE_DIR/panel-extension"
  chmod 700 "$STATE_DIR/panel-extension"
  PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
    python "$PANEL_DIR/start-proxy-controls.py" --session "$session" --output "$BB_PANEL_DIR" --managed-route \
    --environment "$ENVIRONMENT" --credentials-file "$CREDENTIALS" --sessions-dir "$SESSIONS_DIR" --exit-with-pid "$$" > "$HELPER_LOG" 2>&1 &
  BB_HELPER=$!
  for _ in $(seq 1 60); do
    grep -q 'Proxy controls are ready' "$HELPER_LOG" 2>/dev/null && break
    kill -0 "$BB_HELPER" 2>/dev/null || break
    sleep 0.5
  done
  helper_port=$(grep -o 'http://127\.0\.0\.1:[0-9]*' "$BB_PANEL_DIR/background.js" 2>/dev/null | head -1 | sed 's/.*://' || true)
  [ -n "$helper_port" ] || say "The local helper did not start (see $HELPER_LOG). Loading the panel without it."

  say "Uploading the Control Panel to Browserbase..."
  if { if [ -n "$helper_port" ]; then
         kit_python "$KIT_DIR/tools/kernel/build-extension.py" --folder "$BB_PANEL_DIR" --output "$BB_ZIP"
       else
         kit_python "$KIT_DIR/tools/kernel/build-extension.py" --environment "$ENVIRONMENT" --session "$session" --credentials-file "$CREDENTIALS" \
           --managed-route --output "$BB_ZIP"
       fi; } && [ -s "$BB_ZIP" ]; then
    bb_upload /extensions "$BB_ZIP" application/zip
    if bb_ok; then
      extension_id=$(jq -r '.id // empty' "$BB_BODY")
      BB_EXTENSION="$extension_id"
    else
      say "Browserbase did not accept the Control Panel (HTTP $BB_CODE $(bb_reason)). Continuing without it."
    fi
  else
    say "Could not build the Control Panel for Browserbase. Continuing without it."
  fi

  say "Starting a Browserbase browser on the session's proxy..."
  bb_start_browser "$session" "$extension_id" || fail "the Browserbase browser was not started."
  browser_id="$BB_BROWSER"
  cdp=$(jq -r '.connectUrl // empty' "$BB_BODY")

  say ""
  say "A Browserbase browser is running through session $(basename "$session" .json)."
  # Browserbase's own identifier, for its dashboard, session replay and support.
  say "Browserbase browser session: $browser_id"
  if [ -n "$extension_id" ] && [ -n "$cdp" ]; then
    # Browserbase does not say which ID Chrome gave the panel, so ask the browser. The connect address
    # controls the browser, so it goes over stdin, not the command line.
    runtime_id=$(printf '%s\n' "$cdp" | PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
      --with websockets==15.0.1 python "$KIT_DIR/tools/browserbase/panel-id.py" 2>/dev/null | tr -cd 'a-p') || runtime_id=""
  fi
  if [ -n "$runtime_id" ]; then
    if [ -n "$helper_port" ]; then
      # Start the relay before the panel's tab opens, so its first helper request is answered.
      say "Connecting the Browserbase browser to the local helper..."
      printf '%s\n' "$cdp" | PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
        --with websockets==15.0.1 python "$KIT_DIR/tools/browser-use/helper-relay.py" "$helper_port" "$runtime_id" \
        > "$STATE_DIR/browserbase-relay.log" 2>&1 &
      BB_RELAY=$!
      sleep 2
      if kill -0 "$BB_RELAY" 2>/dev/null; then
        say "Control Panel: full, connected to the helper on this machine through the kit's relay. The route is fixed on the session's proxy."
      else
        say "The relay to the local helper did not stay open (see $STATE_DIR/browserbase-relay.log)."
        say "The panel will show 'Helper unavailable'; session details still work."
      fi
    else
      say "Control Panel: session details only. The route is fixed on the session's proxy."
    fi
    tabs+=("chrome-extension://$runtime_id/popup.html")
  fi
  [ -z "$url" ] || tabs+=("$url")
  if [ ${#tabs[@]} -gt 0 ]; then
    if [ -n "$cdp" ] && printf '%s\n' "$cdp" | PYTHONDONTWRITEBYTECODE=1 uv run --quiet --no-project --python "$PYTHON_VERSION" \
         --with websockets==15.0.1 python "$KIT_DIR/tools/browser-use/open-tabs.py" "${tabs[@]}"; then
      [ -z "$runtime_id" ] || say "Control Panel: open in a tab of the Browserbase browser."
    else
      [ -z "$runtime_id" ] || say "Control Panel: loaded, but it could not be opened automatically. Open chrome-extension://$runtime_id/popup.html in the browser."
      [ -z "$url" ] || say "Open $url in the browser yourself."
    fi
  fi
  [ -n "$runtime_id" ] || say "Control Panel: not loaded in this browser. Read the session's stand-ins from the session file instead."
  # Browserbase's live view shows one tab per link, so give the Control Panel's tab and the website's, not the blank first tab.
  bb_call GET "/sessions/$browser_id/debug"
  if bb_ok; then
    live=$(jq -r --arg tab "${runtime_id:+chrome-extension://$runtime_id/}" \
      '([.pages[]? | select($tab != "" and (.url | startswith($tab)))][0].debuggerFullscreenUrl) // .debuggerFullscreenUrl // empty' "$BB_BODY")
    site=$(jq -r --arg tab "$url" '[.pages[]? | select($tab != "" and (.url | startswith($tab)))][0].debuggerFullscreenUrl // empty' "$BB_BODY")
  fi
  if [ -n "$live" ]; then
    say "Watch and control it here (keep these links private; each controls the browser):"
    say "  ${runtime_id:+Control Panel: }$live"
    [ -z "$site" ] || say "  $host: $site"
  else
    say "Browserbase returned no live view link. Open the browser from your Browserbase dashboard."
  fi
  if [ -n "$cdp" ]; then
    say "Connect your agent, Playwright or Stagehand to it here (keep it private, it also controls the browser):"
    say "  $cdp"
  fi
  say ""
  if [ -t 0 ]; then
    read -r -p "Press Enter to close the Browserbase browser and remove what was uploaded. " _ || true
  else
    say "This command runs until the Browserbase browser closes (after 30 minutes) or it is stopped."
    while bb_call GET "/sessions/$browser_id"; [ "$BB_CODE" = 200 ] && jq -e '.status == "RUNNING"' "$BB_BODY" >/dev/null 2>&1; do sleep 30; done
  fi
  say "Closing the Browserbase browser and removing what was uploaded..."
}

cmd_sitecheck() {
  need_uv
  (cd "$SITECHECK_DIR" && uv run awg-sitecheck "$@")
}

usage() {
  sed -n '/^# One entry point/,/^set -euo/{ /^#/s/^# \{0,1\}//p; }' "${BASH_SOURCE[0]}"
  say "AWG_ENVIRONMENT selects dev or sandbox (default); credentials lists all environments, including live."
  say "AWG_HOME overrides ~/.vgs/awg; each environment has its own subdirectory."
}

# Listing Live files does not enable the test-card/browser workflow against Live.
if [ "$ENVIRONMENT" = live ]; then
  case "${1:-}" in
    credentials|test|""|-h|--help|help) ;;
    *) fail "the dev kit runs in dev or sandbox. Use './awg credentials live' to list saved Live credentials." ;;
  esac
fi

case "${1:-}" in
  test)        shift; cmd_test "$@" ;;
  setup)       shift; cmd_setup "$@" ;;
  credentials) shift; cmd_credentials "$@" ;;
  session)     shift; cmd_session "$@" ;;
  start)       shift; cmd_start "$@" ;;
  kernel)      shift; cmd_kernel "$@" ;;
  browser-use) shift; cmd_browser_use "$@" ;;
  browserbase) shift; cmd_browserbase "$@" ;;
  panel)       shift; cmd_panel "$@" ;;
  browser)     shift; cmd_browser "$@" ;;
  cloak-login) shift; cmd_cloak_login "$@" ;;
  kernel-login) provider_login "${KERNEL_KEY[@]}" ;;
  browser-use-login) provider_login "${BROWSER_USE_KEY[@]}" ;;
  browserbase-login) provider_login "${BROWSERBASE_KEY[@]}" ;;
  sitecheck)   shift; cmd_sitecheck "$@" ;;
  ""|-h|--help|help) usage ;;
  *) usage; fail "unknown command: $1" ;;
esac
