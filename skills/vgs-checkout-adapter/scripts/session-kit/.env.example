# Simple KEY=value lines, no shell quotes. Copy privately to .env or .env.<profile>.
VGS_CLIENT_ID=
VGS_CLIENT_SECRET=
VGS_TENANT=
VGS_API=https://sandbox.vgsapi.com
VGS_AUTH_URL=https://auth.verygoodsecurity.com/auth/realms/vgs/protocol/openid-connect/token
ALLOWED_HOSTS=
# User-approved proxy URL, or leave empty and pass --egress-profile with a private JSON path.
EGRESS_PROXY=
# Approved endpoint required for either EGRESS_PROXY or --egress-profile.
EGRESS_ALLOWED_HOST=
EGRESS_ALLOWED_PORT=
# Absolute directory with verified <profile>-<tenant>-<provider>.json ledgers.
ADAPTER_REGISTRY_DIR=
